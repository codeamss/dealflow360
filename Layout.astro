---
export interface Props {
  title?: string;
  activeModule?: string;
}

const { title = "DealFlow360", activeModule } = Astro.props;
const currentPath = Astro.url.pathname;
const isAuthPage = currentPath === '/login' || currentPath === '/register';

// Determine active module based on path or prop
const getActive = (module: string) => {
  if (activeModule) return activeModule.toLowerCase() === module.toLowerCase();
  if (module === 'Dashboard' && currentPath === '/') return true;
  if (module === 'Quotations' && currentPath.startsWith('/pipeline')) return true;
  if (module === 'Approvals' && currentPath.startsWith('/approvals')) return true;
  if (module === 'Fulfillment' && currentPath.startsWith('/fulfillment')) return true;
  if (module === 'Subscriptions' && currentPath.startsWith('/subscriptions')) return true;
  if (module === 'Invoices' && currentPath.startsWith('/invoices')) return true;
  if (module === 'Deal Health' && currentPath.startsWith('/deal-health')) return true;
  if (module === 'Reports' && currentPath.startsWith('/reports')) return true;
  if (module === 'Product' && (currentPath.startsWith('/products') || currentPath.startsWith('/quotation/new'))) return true;
  if (module === 'Governance' && currentPath.startsWith('/settings')) return true;
  return false;
};
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900 antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <script is:inline>
    // Early Route Guard: Enforce /login as mandatory entering gate & RBAC Customer boundary
    (function() {
      var path = window.location.pathname;
      var isAuth = path === '/login' || path === '/register';
      var userRaw = localStorage.getItem('dealflow360_user');
      if (!isAuth && !userRaw) {
        window.location.href = '/login';
        return;
      }
      if (userRaw && !isAuth) {
        try {
          var userObj = JSON.parse(userRaw);
          // Block Customers from accessing internal sales operations routes
          var isInternalPath = path === '/' || 
            path.startsWith('/pipeline') || 
            path.startsWith('/approvals') || 
            path.startsWith('/fulfillment') || 
            path.startsWith('/deal-health') || 
            path.startsWith('/reports') || 
            path.startsWith('/products') ||
            path.startsWith('/settings');

          if (userObj.role === 'Customer' && isInternalPath) {
            window.location.href = '/portal/quote/1001';
          }
        } catch (e) {}
      }
    })();
  </script>
  <!-- Modern Enterprise Font Engine: Plus Jakarta Sans, Inter, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --font-sans: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    * { 
      box-sizing: border-box; 
    }

    html {
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11', 'calt';
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      letter-spacing: -0.011em;
      line-height: 1.5;
    }

    /* Headings hierarchy with calibrated optical kerning */
    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-sans);
      letter-spacing: -0.025em;
      text-wrap: balance;
    }

    /* Code, numeric data, table metrics, currency amounts */
    .font-mono,
    code,
    kbd,
    samp,
    pre,
    [data-mono] {
      font-family: var(--font-mono) !important;
      font-feature-settings: 'tnum' on, 'zero' on;
      font-variant-numeric: tabular-nums slashed-zero;
      letter-spacing: -0.015em;
    }

    /* Standardize form inputs & buttons to inherit geometric fonts */
    input, button, select, textarea {
      font-family: inherit;
    }

    /* Premium text selection highlighting */
    ::selection {
      background-color: rgba(56, 189, 248, 0.3);
      color: #ffffff;
    }

    .toast-enter {
      animation: toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .toast-exit {
      animation: toastOut 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes toastIn {
      from { opacity: 0; transform: translateY(-12px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes toastOut {
      from { opacity: 1; transform: translateY(0) scale(1); }
      to { opacity: 0; transform: translateY(-12px) scale(0.96); }
    }
    /* Yellow Callout Style matching Excalidraw */
    .excalidraw-callout {
      border: 1.5px solid #ca8a04;
      background-color: rgba(254, 240, 138, 0.12);
      color: #fef08a;
      border-radius: 0.5rem;
      padding: 0.625rem 1rem;
      font-size: 0.8125rem;
      font-style: italic;
    }
    .excalidraw-callout-light {
      border: 1.5px solid #eab308;
      background-color: #fefce8;
      color: #854d0e;
      border-radius: 0.5rem;
      padding: 0.625rem 1rem;
      font-size: 0.8125rem;
      font-style: italic;
    }
    /* Complete scrollbar elimination for navigation and custom scroll elements */
    nav, nav * {
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
    }
    nav::-webkit-scrollbar,
    nav *::-webkit-scrollbar,
    .scrollbar-none::-webkit-scrollbar,
    .no-scrollbar::-webkit-scrollbar {
      display: none !important;
      width: 0 !important;
      height: 0 !important;
      background: transparent !important;
    }
    .scrollbar-none,
    .no-scrollbar {
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
    }
    /* Form input & select contrast safeguards */
    select option {
      background-color: #0f172a !important;
      color: #f8fafc !important;
    }
    input::placeholder,
    textarea::placeholder {
      color: #94a3b8 !important;
      opacity: 1 !important;
    }
  </style>
</head>
