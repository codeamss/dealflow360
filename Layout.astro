---
export interface Props {
  title?: string;
}

const { title = "DealFlow360" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50 antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    * { 
      box-sizing: border-box; 
    }
    html, body {
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    .toast-enter {
      animation: toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .toast-exit {
      animation: toastOut 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes toastIn {
      from { opacity: 0; transform: translateY(-12px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes toastOut {
      from { opacity: 1; transform: translateY(0) scale(1); }
      to { opacity: 0; transform: translateY(-12px) scale(0.96); }
    }
  </style>
</head>
<body class="min-h-full flex flex-col bg-slate-50 text-slate-900">
  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed top-5 right-5 z-[9999] flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

  <!-- Navigation -->
  <nav class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-40 transition-shadow duration-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Brand & Nav Links -->
        <div class="flex items-center gap-8">
          <a href="/" class="flex items-center gap-2.5 group transition-transform active:scale-95">
            <div class="w-9 h-9 bg-gradient-to-tr from-indigo-600 to-indigo-500 rounded-xl flex items-center justify-center shadow-md shadow-indigo-200 group-hover:shadow-indigo-300 transition-all">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="text-base font-bold tracking-tight text-slate-900 leading-none">DealFlow<span class="text-indigo-600">360</span></span>
              <span class="text-[10px] font-medium text-slate-500 tracking-wider uppercase mt-0.5">B2B Sales Engine</span>
            </div>
          </a>
          
          <!-- Desktop Navigation Links -->
          <div class="hidden md:flex items-center gap-1.5" id="desktopNav">
            <a 
              href="/" 
              class={`px-3 py-2 text-sm font-medium rounded-lg transition-all ${currentPath === '/' ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80'}`}
            >
              Dashboard
            </a>
            <a 
              href="/pipeline" 
              class={`px-3 py-2 text-sm font-medium rounded-lg transition-all ${currentPath.startsWith('/pipeline') ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80'}`}
              id="navLinkPipeline"
            >
              Pipeline
            </a>
            <a 
              href="/quotation/new" 
              class={`px-3 py-2 text-sm font-medium rounded-lg transition-all ${currentPath.startsWith('/quotation/new') ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80'}`}
              id="navLinkNewQuote"
            >
              New Quote
            </a>
            <a 
              href="/settings" 
              class={`px-3 py-2 text-sm font-medium rounded-lg transition-all ${currentPath.startsWith('/settings') ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/80'}`}
              id="navLinkSettings"
            >
              Settings
            </a>
          </div>
        </div>

        <!-- Right Side: User Profile & Mobile Toggle -->
        <div class="flex items-center gap-3">
          <div id="userInfo" class="flex items-center">
            <div class="h-8 w-24 bg-slate-100 animate-pulse rounded-lg"></div>
          </div>

          <!-- Mobile Hamburger Toggle -->
          <button 
            id="mobileMenuToggle" 
            type="button" 
            aria-label="Toggle navigation menu"
            class="md:hidden p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
          >
            <svg id="menuOpenIcon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menuCloseIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobileDrawer" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-5 space-y-1.5 shadow-lg">
      <a 
        href="/" 
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${currentPath === '/' ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-100'}`}
      >
        Dashboard
      </a>
      <a 
        href="/pipeline" 
        id="mobileNavLinkPipeline"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${currentPath.startsWith('/pipeline') ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-100'}`}
      >
        Pipeline
      </a>
      <a 
        href="/quotation/new" 
        id="mobileNavLinkNewQuote"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${currentPath.startsWith('/quotation/new') ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-100'}`}
      >
        New Quotation
      </a>
      <a 
        href="/settings" 
        id="mobileNavLinkSettings"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${currentPath.startsWith('/settings') ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-100'}`}
      >
        Settings
      </a>
      <div class="pt-3 border-t border-slate-100 flex justify-between items-center px-1">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">DealFlow360 Platform</span>
        <span class="text-xs px-2 py-0.5 bg-indigo-50 text-indigo-700 rounded-full font-medium">v2.0</span>
      </div>
    </div>
  </nav>

  <!-- Main Content Area -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <slot />
  </main>

  <!-- Global Modern Footer -->
  <footer class="bg-white border-t border-slate-200 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
          <span>System Operational • All Services Connected</span>
        </div>
        <div>
          © 2026 DealFlow360 Inc. Enterprise B2B Sales Platform.
        </div>
        <div class="flex gap-4">
          <a href="#" class="hover:text-slate-700 transition-colors">Documentation</a>
          <a href="#" class="hover:text-slate-700 transition-colors">Security</a>
          <a href="#" class="hover:text-slate-700 transition-colors">Support</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Core Client Scripts: Auth, Mobile Nav, Global Toast -->
  <script is:inline>
    // Global Toast Notification Helper
    window.showToast = function(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = 'toast-enter pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl shadow-lg border text-sm font-medium transition-all max-w-md';
      
      if (type === 'success') {
        toast.className += ' bg-white border-emerald-200 text-slate-800 shadow-emerald-500/10';
        toast.innerHTML = `
          <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <span class="flex-1">${message}</span>
        `;
      } else if (type === 'error') {
        toast.className += ' bg-white border-rose-200 text-slate-800 shadow-rose-500/10';
        toast.innerHTML = `
          <div class="w-7 h-7 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </div>
          <span class="flex-1">${message}</span>
        `;
      } else {
        toast.className += ' bg-white border-indigo-200 text-slate-800 shadow-indigo-500/10';
        toast.innerHTML = `
          <div class="w-7 h-7 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <span class="flex-1">${message}</span>
        `;
      }

      container.appendChild(toast);

      setTimeout(() => {
        toast.classList.remove('toast-enter');
        toast.classList.add('toast-exit');
        setTimeout(() => toast.remove(), 250);
      }, 3500);
    };

    // User authentication state handling in Layout
    function updateAuthUI() {
      const user = localStorage.getItem('dealflow360_user');
      const token = localStorage.getItem('dealflow360_token');
      const userInfoDiv = document.getElementById('userInfo');
      if (!userInfoDiv) return;

      if (user && token) {
        try {
          const userData = JSON.parse(user);
          const isCustomer = userData.role === 'Customer';
          const initials = (userData.name || 'User')
            .split(' ')
            .map(n => n[0])
            .join('')
            .toUpperCase()
            .substring(0, 2);

          const roleColors = {
            'Customer': 'bg-orange-50 text-orange-700 border-orange-200',
            'Sales Rep': 'bg-blue-50 text-blue-700 border-blue-200',
            'Sales Manager': 'bg-indigo-50 text-indigo-700 border-indigo-200',
            'Finance': 'bg-emerald-50 text-emerald-700 border-emerald-200',
            'Admin': 'bg-purple-50 text-purple-700 border-purple-200'
          };
          const badgeClass = roleColors[userData.role] || 'bg-slate-100 text-slate-700 border-slate-200';

          userInfoDiv.innerHTML = `
            <div class="flex items-center gap-2.5">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-indigo-600 text-white flex items-center justify-center font-bold text-xs shadow-sm">
                  ${initials}
                </div>
                <div class="hidden sm:block text-left">
                  <div class="text-xs font-semibold text-slate-800 leading-tight">${userData.name || userData.email}</div>
                  <span class="inline-block text-[10px] font-medium px-1.5 py-0.2 rounded border ${badgeClass} mt-0.5 leading-tight">
                    ${userData.role}
                  </span>
                </div>
              </div>
              <button 
                onclick="logout()" 
                title="Sign out of account"
                class="px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-rose-600 hover:bg-rose-50 border border-slate-200 hover:border-rose-200 rounded-lg transition-colors flex items-center gap-1"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                <span class="hidden md:inline">Sign out</span>
              </button>
            </div>
          `;

          // Adapt links for customer role
          const newQuoteLink = document.getElementById('navLinkNewQuote');
          const mobileNewQuoteLink = document.getElementById('mobileNavLinkNewQuote');
          const pipelineLink = document.getElementById('navLinkPipeline');
          const mobilePipelineLink = document.getElementById('mobileNavLinkPipeline');

          if (isCustomer) {
            if (newQuoteLink) newQuoteLink.style.display = 'none';
            if (mobileNewQuoteLink) mobileNewQuoteLink.style.display = 'none';
            if (pipelineLink) {
              pipelineLink.href = '/portal/quote/1001';
              pipelineLink.textContent = 'Quote Portal';
            }
            if (mobilePipelineLink) {
              mobilePipelineLink.href = '/portal/quote/1001';
              mobilePipelineLink.textContent = 'Quote Portal';
            }
          }
        } catch (e) {
          console.error("Error parsing user data in Layout:", e);
          renderSignInButton(userInfoDiv);
        }
      } else {
        renderSignInButton(userInfoDiv);
      }
    }

    function renderSignInButton(container) {
      container.innerHTML = `
        <a 
          href="/login" 
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 active:scale-[0.98] text-white text-xs font-medium rounded-lg shadow-sm shadow-indigo-200 transition-all"
        >
          <span>Sign In</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      `;
    }

    function logout() {
      localStorage.removeItem('dealflow360_user');
      localStorage.removeItem('dealflow360_token');
      if (window.showToast) {
        window.showToast('Signed out successfully', 'info');
      }
      setTimeout(() => {
        window.location.href = '/login';
      }, 300);
    }

    // Mobile Menu Toggle
    document.addEventListener('DOMContentLoaded', () => {
      updateAuthUI();

      const toggleBtn = document.getElementById('mobileMenuToggle');
      const drawer = document.getElementById('mobileDrawer');
      const openIcon = document.getElementById('menuOpenIcon');
      const closeIcon = document.getElementById('menuCloseIcon');

      if (toggleBtn && drawer) {
        toggleBtn.addEventListener('click', () => {
          const isOpen = !drawer.classList.contains('hidden');
          if (isOpen) {
            drawer.classList.add('hidden');
            openIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
          } else {
            drawer.classList.remove('hidden');
            openIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
          }
        });
      }
    });

    window.addEventListener('storage', (e) => {
      if (e.key === 'dealflow360_user' || e.key === 'dealflow360_token') {
        updateAuthUI();
      }
    });
  </script>
</body>
</html>