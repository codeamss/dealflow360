  <!-- Scripts for Toast, Persona Switching, Mobile Nav -->
  <script is:inline>
    // Global Toast Notification Helper
    window.showToast = function(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = 'toast-enter pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl shadow-xl border text-sm font-medium transition-all max-w-md';
      
      if (type === 'success') {
        toast.className += ' bg-slate-900 border-emerald-500 text-white shadow-emerald-500/20';
        toast.innerHTML = `
          <div class="w-6 h-6 rounded-lg bg-emerald-500 text-slate-950 flex items-center justify-center flex-shrink-0 font-bold">
            ✓
          </div>
          <span class="flex-1">${message}</span>
        `;
      } else if (type === 'error') {
        toast.className += ' bg-slate-900 border-rose-500 text-white shadow-rose-500/20';
        toast.innerHTML = `
          <div class="w-6 h-6 rounded-lg bg-rose-500 text-white flex items-center justify-center flex-shrink-0 font-bold">
            ✕
          </div>
          <span class="flex-1">${message}</span>
        `;
      } else {
        toast.className += ' bg-slate-900 border-sky-400 text-white shadow-sky-400/20';
        toast.innerHTML = `
          <div class="w-6 h-6 rounded-lg bg-sky-400 text-slate-950 flex items-center justify-center flex-shrink-0 font-bold">
            ℹ
          </div>
          <span class="flex-1">${message}</span>
        `;
      }

      container.appendChild(toast);

      setTimeout(() => {
        toast.classList.remove('toast-enter');
        toast.classList.add('toast-exit');
        setTimeout(() => toast.remove(), 250);
      }, 3500);
    };

    // Persona Switcher Handler
    window.switchPersona = function(role) {
      const personaMap = {
        'Sales Rep': { name: 'Sarah Jenkins', email: 'sarah.j@dealflow360.com', role: 'Sales Rep' },
        'Sales Manager': { name: 'Sarah Chen', email: 'sarah.chen@dealflow360.com', role: 'Sales Manager' },
        'Finance': { name: 'Rachel Iyer', email: 'rachel.iyer@dealflow360.com', role: 'Finance' },
        'Customer': { name: 'Alex Miller (Acme Corp)', email: 'procurement@acme.com', role: 'Customer' },
        'Admin': { name: 'System Administrator', email: 'admin@dealflow360.com', role: 'Admin' }
      };

      const user = personaMap[role] || personaMap['Sales Rep'];
      localStorage.setItem('dealflow360_user', JSON.stringify(user));
      localStorage.setItem('dealflow360_token', 'mock_token_' + Date.now());

      if (window.showToast) {
        window.showToast(`Switched active persona to ${user.name} (${user.role})`, 'info');
      }

      if (role === 'Customer') {
        setTimeout(() => { window.location.href = '/portal/quote/1001'; }, 300);
      } else {
        setTimeout(() => { window.location.reload(); }, 300);
      }
    };

    // Global Sign Out Helper
    window.signOut = function() {
      localStorage.removeItem('dealflow360_user');
      localStorage.removeItem('dealflow360_token');
      if (window.showToast) {
        window.showToast('Signed out of DealFlow360', 'info');
      }
      setTimeout(() => {
        window.location.href = '/login';
      }, 250);
    };

    // Initialize Persona dropdown and role-based navigation adjustments
    document.addEventListener('DOMContentLoaded', () => {
      const stored = localStorage.getItem('dealflow360_user');
      if (stored) {
        try {
          const user = JSON.parse(stored);
          const nameEl = document.getElementById('navUserName');
          const roleEl = document.getElementById('navUserRole');
          const avatarEl = document.getElementById('navUserAvatar');
          if (nameEl && user.name) nameEl.textContent = user.name;
          if (roleEl && user.role) roleEl.textContent = user.role;
          if (avatarEl && user.name) avatarEl.textContent = user.name.charAt(0).toUpperCase();

          // If current session is a Customer, customize navigation bar to customer portal and billing
          if (user.role === 'Customer') {
            const pills = document.getElementById('modulePills');
            if (pills) {
              pills.innerHTML = `
                <a href="/portal/quote/1001" class="px-3.5 py-1.5 rounded-full text-xs font-black bg-slate-900 text-white shadow-sm ring-1 ring-slate-950 flex items-center gap-1.5">
                  <span>Customer Quote Portal (#1001)</span>
                </a>
                <a href="/invoices" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-sky-300/40 text-slate-950 hover:bg-sky-300 border border-sky-500/40 transition-all flex items-center gap-1.5">
                  <span>Billing & Invoices</span>
                </a>
                <a href="/subscriptions" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-sky-300/40 text-slate-950 hover:bg-sky-300 border border-sky-500/40 transition-all flex items-center gap-1.5">
                  <span>Subscriptions</span>
                </a>
                <span class="text-[11px] font-bold text-slate-950 bg-sky-300/80 px-3 py-1 rounded-full border border-sky-600/30">
                  Role: Customer
                </span>
              `;
            }
            const drawer = document.getElementById('mobileDrawer');
            if (drawer) {
              drawer.innerHTML = `
                <a href="/portal/quote/1001" class="block px-3 py-2 rounded-lg text-sm font-bold text-slate-950 hover:bg-sky-200">Customer Quote Portal</a>
                <a href="/invoices" class="block px-3 py-2 rounded-lg text-sm font-bold text-slate-950 hover:bg-sky-200">Billing & Invoices</a>
                <a href="/subscriptions" class="block px-3 py-2 rounded-lg text-sm font-bold text-slate-950 hover:bg-sky-200">Subscriptions</a>
              `;
            }
          }
        } catch (e) {}
      }

      // Mobile Menu
      const toggleBtn = document.getElementById('mobileMenuToggle');
      const drawer = document.getElementById('mobileDrawer');
      const openIcon = document.getElementById('menuOpenIcon');
      const closeIcon = document.getElementById('menuCloseIcon');

      if (toggleBtn && drawer) {
        toggleBtn.addEventListener('click', () => {
          const isOpen = !drawer.classList.contains('hidden');
          if (isOpen) {
            drawer.classList.add('hidden');
            openIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
          } else {
            drawer.classList.remove('hidden');
            openIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
          }
        });
      }
    });
  </script>
</body>
</html>