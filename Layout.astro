        <a href="/" class="block px-3 py-2 rounded-lg text-sm font-bold text-slate-950 hover:bg-sky-200">Dashboard</a>
        <a href="/pipeline" class="block px-3 py-2 rounded-lg text-sm font-bold text-slate-950 hover:bg-sky-200">Quotations</a>
        <a href="/approvals" class="block px-3 py-2 rounded-lg text-sm font-bold text-slate-950 hover:bg-sky-200">Approvals</a>
