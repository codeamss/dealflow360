---
export interface Props {
  title?: string;
}

const { title = "DealFlow360" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; }
  </style>
  <script>
    // Function to check authentication status and update UI
    function updateAuthUI() {
      const user = localStorage.getItem('dealflow360_user');
      const token = localStorage.getItem('dealflow360_token');
      
      const userInfoDiv = document.getElementById('userInfo');
      if (!userInfoDiv) return;
      
      if (user && token) {
        try {
          const userData = JSON.parse(user);
          const isCustomer = userData.role === 'Customer';
          
          userInfoDiv.innerHTML = `
            <div class="flex items-center space-x-3">
              <span class="text-sm text-gray-300">${userData.name} (${userData.role})</span>
              <div class="w-8 h-8 ${isCustomer ? 'bg-orange-500' : 'bg-blue-500'} rounded-full flex items-center justify-center text-white font-bold">
                ${userData.name.charAt(0)}${userData.name.split(' ')[1]?.charAt(0) || userData.name.charAt(1) || ''}
              </div>
              <button onclick="logout()" class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white text-xs rounded transition">
                Logout
              </button>
            </div>
          `;
          
          // Update navigation based on role
          const newQuoteLink = document.querySelector('a[href="/quotation/new"]');
          if (newQuoteLink) {
            if (isCustomer) {
              newQuoteLink.style.display = 'none';
            } else {
              newQuoteLink.style.display = 'block';
            }
          }
          
          // Update pipeline link for customers
          const pipelineLink = document.querySelector('a[href="/pipeline"]');
          if (pipelineLink && isCustomer) {
            pipelineLink.href = '/portal/quote/1001';
            pipelineLink.textContent = 'Customer Portal';
          }
          
        } catch (e) {
          userInfoDiv.innerHTML = `
            <a href="/login" class="px-3 py-2 text-sm font-medium hover:bg-gray-700 hover:text-white transition-colors rounded-md">
              Sign In
            </a>
          `;
        }
      } else {
        userInfoDiv.innerHTML = `
          <a href="/login" class="px-3 py-2 text-sm font-medium hover:bg-gray-700 hover:text-white transition-colors rounded-md">
            Sign In
          </a>
        `;
      }
    }
    
    function logout() {
      localStorage.removeItem('dealflow360_user');
      localStorage.removeItem('dealflow360_token');
      window.location.href = '/login';
    }
  </script>
</head>
<body class="min-h-screen bg-gray-50">
  <nav class="bg-gray-900 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center">
          <div class="text-xl font-bold text-white">DealFlow360</div>
          <div class="ml-10 flex items-baseline space-x-4">
            <a href="/" class="px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-700 hover:text-white transition-colors">Quotations</a>
            <a href="/pipeline" class="px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-700 hover:text-white transition-colors">Pipeline</a>
            <a href="/quotation/new" class="px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-700 hover:text-white transition-colors">New Quote</a>
            <a href="/settings" class="px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-700 hover:text-white transition-colors">Settings</a>
          </div>
        </div>
        <div class="flex items-center space-x-4" id="userInfo">
          <span class="text-sm text-gray-300">Loading...</span>
        </div>
      </div>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <slot />
  </main>

  <footer class="bg-gray-100 border-t mt-12 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-gray-600 text-sm">
      © 2026 DealFlow360 B2B Sales Platform. All rights reserved.
    </div>
  </footer>
  
  <script>
    // Update auth UI on page load
    document.addEventListener('DOMContentLoaded', function() {
      updateAuthUI();
    });
    
    // Update auth UI when storage changes
    window.addEventListener('storage', function(e) {
      if (e.key === 'dealflow360_user' || e.key === 'dealflow360_token') {
        updateAuthUI();
      }
    });
  </script>
</body>
</html>