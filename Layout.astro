  <!-- Main Content Canvas (Dark Slate styling matching Excalidraw) -->
  <main class="flex-1 w-full max-w-[1700px] mx-auto px-4 sm:px-6 py-6">
    <slot />
  </main>

  <!-- Global Footer -->
  <footer class="bg-slate-950 border-t border-slate-800 text-slate-400 text-xs py-5 mt-auto">
    <div class="max-w-[1700px] mx-auto px-4 sm:px-6 flex flex-col sm:flex-row justify-between items-center gap-3">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
        <span class="font-semibold text-slate-300">DealFlow360</span>
