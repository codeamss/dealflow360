---
import Layout from '../Layout.astro';
import { products, warehouses } from '../mockData.js';
---

<Layout title="DealFlow360 - Discount Tiers & Governance Setup" activeModule="Governance">
  <div class="space-y-8 max-w-[1500px] mx-auto">
    
    <!-- ========================================================================= -->
    <!-- SCREEN 18: Discount tiers and approval chains (Exact Excalidraw Layout)   -->
    <!-- ========================================================================= -->
    <div class="space-y-6 bg-slate-900/90 border-2 border-slate-700/90 rounded-2xl p-6 sm:p-8 shadow-2xl">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Discount tiers and approval chains</h1>
        <p class="text-slate-400 text-xs sm:text-sm mt-0.5">
          Algorithmic ceilings, governance limits, and blended risk escalation thresholds
        </p>
      </div>

      <!-- Two Side-by-Side Tables: Tier Discount Ceilings & Category Discount Ceilings -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Table 1: Tier Discount Ceilings -->
        <div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-950/40">
          <div class="px-4 py-2.5 bg-slate-800/80 border-b border-slate-700">
            <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Tier Discount Ceilings</span>
          </div>
          <table class="min-w-full divide-y divide-slate-700 text-xs sm:text-sm">
            <thead class="bg-slate-900/80 text-slate-400 font-bold uppercase text-[11px]">
              <tr>
                <th class="px-5 py-2.5 text-left">Tier</th>
                <th class="px-5 py-2.5 text-right">Max Discount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 text-slate-200">
              <tr class="hover:bg-slate-800/40">
                <td class="px-5 py-3 font-bold text-amber-400">Bronze</td>
                <td class="px-5 py-3 text-right font-mono font-bold">5 percent</td>
              </tr>
              <tr class="hover:bg-slate-800/40">
                <td class="px-5 py-3 font-bold text-slate-300">Silver</td>
                <td class="px-5 py-3 text-right font-mono font-bold">10 percent</td>
              </tr>
              <tr class="hover:bg-slate-800/40">
                <td class="px-5 py-3 font-bold text-sky-400">Gold</td>
                <td class="px-5 py-3 text-right font-mono font-bold">15 Percent</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Table 2: Category Discount Ceilings -->
        <div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-950/40">
          <div class="px-4 py-2.5 bg-slate-800/80 border-b border-slate-700">
            <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Category Discount Ceilings</span>
          </div>
          <table class="min-w-full divide-y divide-slate-700 text-xs sm:text-sm">
            <thead class="bg-slate-900/80 text-slate-400 font-bold uppercase text-[11px]">
              <tr>
                <th class="px-5 py-2.5 text-left">Category</th>
                <th class="px-5 py-2.5 text-right">Max Discount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 text-slate-200">
              <tr class="hover:bg-slate-800/40">
                <td class="px-5 py-3 font-bold text-blue-400">Hardware</td>
                <td class="px-5 py-3 text-right font-mono font-bold">15 percent</td>
              </tr>
              <tr class="hover:bg-slate-800/40">
                <td class="px-5 py-3 font-bold text-purple-400">Services</td>
                <td class="px-5 py-3 text-right font-mono font-bold">10 percent</td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>

      <!-- Table 3: Approval Chain Rules -->
      <div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-950/40">
        <div class="px-4 py-2.5 bg-slate-800/80 border-b border-slate-700">
          <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Approval Chain Rules</span>
        </div>
        <table class="min-w-full divide-y divide-slate-700 text-xs sm:text-sm">
          <thead class="bg-slate-900/80 text-slate-400 font-bold uppercase text-[11px]">
            <tr>
              <th class="px-5 py-2.5 text-left">Discount Range / Condition</th>
              <th class="px-5 py-2.5 text-left">Required Approval Level</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-slate-200">
            <tr class="hover:bg-slate-800/40">
              <td class="px-5 py-3 font-medium">Within tier/Category limit</td>
              <td class="px-5 py-3 font-bold text-emerald-400">No approval needed</td>
            </tr>
            <tr class="hover:bg-slate-800/40">
              <td class="px-5 py-3 font-medium">Over Limit, blended risk medium</td>
              <td class="px-5 py-3 font-bold text-amber-400">Sales manager</td>
            </tr>
            <tr class="hover:bg-slate-800/40">
              <td class="px-5 py-3 font-medium">Over limit, blended high risk</td>
              <td class="px-5 py-3 font-bold text-rose-400">Sales manager then finance</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Save Configuration Button (Sky Blue) -->
      <div>
        <button
          type="button"
          onclick="saveConfig()"
          class="px-6 py-2.5 bg-sky-400 hover:bg-sky-300 text-slate-950 font-bold rounded-xl text-xs shadow-md transition-all active:scale-95 flex items-center gap-2"
        >
          <span>Save configuration</span>
        </button>
      </div>

      <!-- Yellow Governance Callout Note matching Excalidraw Screen 18 -->
      <div class="excalidraw-callout">
        When a quote mixes categories with different ceilings, the system must compute a blended risk score and route to the highest required level. All approvals, rejections, and edits must be logged with user, timestamp, and reason.
      </div>
    </div>


    <!-- ========================================================================= -->
    <!-- Catalog Price Lists & Regional Warehouses Tabs                            -->
    <!-- ========================================================================= -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Catalog Overview with 8-per-page Pagination -->
      <div class="bg-slate-900/90 border border-slate-700/80 rounded-2xl p-6 shadow-xl space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-base font-bold text-white">Commercial Catalog Items</h2>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-500/20 text-sky-300 border border-sky-500/40">
                8 items per page
              </span>
            </div>
            <p class="text-xs text-slate-400 mt-0.5">Products and recurring subscription flags ({products.length} total items)</p>
          </div>

          <!-- Quick Search Filter -->
          <div class="w-full sm:w-56">
            <input 
              type="text" 
              id="catalogSearchInput" 
              oninput="filterCatalog()" 
              placeholder="Search catalog products..." 
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-1.5 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-400"
            />
          </div>
        </div>

        <div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-950/40">
          <table class="min-w-full divide-y divide-slate-700 text-xs">
            <thead class="bg-slate-800/80 text-slate-300 font-bold uppercase text-[10px]">
              <tr>
                <th class="px-4 py-2.5 text-left">Product</th>
                <th class="px-3 py-2.5 text-left">Category</th>
                <th class="px-3 py-2.5 text-right">Base Price</th>
                <th class="px-3 py-2.5 text-center">Type</th>
              </tr>
            </thead>
            <tbody id="catalogTableBody" class="divide-y divide-slate-800 text-slate-200">
              <!-- Populated dynamically via JS (8 items per page) -->
            </tbody>
          </table>
        </div>

        <!-- Catalog Pagination Controls Bar -->
        <div class="flex flex-col sm:flex-row justify-between items-center px-4 py-2.5 rounded-xl bg-slate-950/50 border border-slate-800 text-xs text-slate-400 gap-3">
          <div id="catalogPaginationInfo" class="text-slate-400 font-medium text-[11px] sm:text-xs">
            Showing 1–8 of {products.length} products
          </div>

          <div class="flex items-center gap-1.5" id="catalogPaginationControls">
            <!-- Dynamically populated page buttons -->
          </div>
        </div>
      </div>

      <!-- Regional Warehouses -->
      <div class="bg-slate-900/90 border border-slate-700/80 rounded-2xl p-6 shadow-xl space-y-4">
        <div>
          <h2 class="text-base font-bold text-white">Registered Distribution Warehouses</h2>
          <p class="text-xs text-slate-400">Connected to multi-warehouse fulfillment splitting router</p>
        </div>

        <div class="space-y-3">
          {warehouses.map(wh => (
            <div key={wh.id} class="p-4 rounded-xl border border-slate-700 bg-slate-950/40 flex justify-between items-center">
              <div>
                <h4 class="font-bold text-white text-sm">{wh.name}</h4>
                <p class="text-xs text-slate-400">{wh.location}</p>
              </div>
              <div class="text-right">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
                  Online
                </span>
                <p class="text-[11px] font-mono text-slate-400 mt-1">
                  {wh.inventory.reduce((sum, i) => sum + i.quantity, 0)} units total
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- Admin Role Governance & User Permissions (Admin-Only Role Assignment)      -->
    <!-- ========================================================================= -->
    <div class="space-y-6 bg-slate-900/90 border-2 border-slate-700/90 rounded-2xl p-6 sm:p-8 shadow-2xl" id="roleGovernanceSection">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-800 pb-5">
        <div>
          <div class="flex items-center gap-3">
            <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Admin Role Governance</h2>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-500/40">
              Admin Exclusive
            </span>
          </div>
          <p class="text-slate-400 text-xs sm:text-sm mt-1">
            Assign internal permissions (Sales Rep, Sales Manager, Finance, Admin) to registered users. Self-registered users default to Customer.
          </p>
        </div>

        <!-- Admin Access Status Banner -->
        <div id="adminStatusBanner" class="flex items-center gap-2">
          <!-- Populated by JavaScript -->
        </div>
      </div>

      <!-- Permission Notice if Non-Admin -->
      <div id="nonAdminNotice" class="hidden p-4 rounded-xl bg-amber-950/40 border border-amber-500/40 text-amber-200 text-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span><strong>Restricted Access:</strong> You are currently viewing as a non-admin. Role modifications can only be performed by an Administrator.</span>
        </div>
        <button
          type="button"
          onclick="window.switchPersona && window.switchPersona('Admin')"
          class="px-3 py-1.5 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs whitespace-nowrap transition-all shadow-md cursor-pointer"
        >
          Switch to Admin Persona
        </button>
      </div>

      <!-- User Permissions Table -->
      <div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-950/40">
        <div class="px-5 py-3 bg-slate-800/80 border-b border-slate-700 flex justify-between items-center">
          <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Registered System Users & Role Assignments</span>
          <span id="userCountBadge" class="text-[11px] font-bold bg-slate-700 text-slate-300 px-2.5 py-0.5 rounded-full">
            Loading users...
          </span>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-700 text-xs sm:text-sm">
            <thead class="bg-slate-900/80 text-slate-400 font-bold uppercase text-[11px]">
              <tr>
                <th class="px-5 py-3 text-left">User</th>
                <th class="px-5 py-3 text-left">Email Address</th>
                <th class="px-5 py-3 text-left">Current Role</th>
                <th class="px-5 py-3 text-left">Grant New Role</th>
                <th class="px-5 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="userTableBody" class="divide-y divide-slate-800 text-slate-200">
              <!-- Rendered dynamically -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Yellow Governance Callout Note -->
      <div class="excalidraw-callout">
        Enterprise RBAC Governance: New accounts register as Customer to access counter-offers and quote terms. Internal company roles (Sales Rep, Sales Manager, Finance, Admin) can only be granted by an Administrator here.
      </div>
    </div>

  </div>

  <script is:inline define:vars={{ initialCatalog: products }}>
    function saveConfig() {
      if (window.showToast) {
        window.showToast('Configuration saved! Governance tiers & approval chains updated.', 'success');
      }
    }

    // ==========================================
    // Commercial Catalog 8-Items-Per-Page Logic
    // ==========================================
    let catalogItems = initialCatalog || [];
    let catalogPage = 1;
    const catalogPageSize = 8;
    let catalogSearchQuery = '';

    function renderCatalog() {
      const tbody = document.getElementById('catalogTableBody');
      const infoEl = document.getElementById('catalogPaginationInfo');
      const controlsEl = document.getElementById('catalogPaginationControls');
      if (!tbody) return;

      const q = (catalogSearchQuery || '').toLowerCase().trim();
      const filtered = catalogItems.filter(p => {
        if (!q) return true;
        return (p.name && p.name.toLowerCase().includes(q)) || 
               (p.category && p.category.toLowerCase().includes(q)) || 
               (p.sku && p.sku.toLowerCase().includes(q));
      });

      const totalPages = Math.ceil(filtered.length / catalogPageSize) || 1;
      if (catalogPage > totalPages) catalogPage = totalPages;
      if (catalogPage < 1) catalogPage = 1;

      const startIndex = (catalogPage - 1) * catalogPageSize;
      const pageItems = filtered.slice(startIndex, startIndex + catalogPageSize);

      if (infoEl) {
        if (filtered.length === 0) {
          infoEl.textContent = 'Showing 0 of 0 products';
        } else {
          infoEl.textContent = `Showing ${startIndex + 1}–${Math.min(startIndex + catalogPageSize, filtered.length)} of ${filtered.length} products`;
        }
      }

      tbody.innerHTML = '';
      if (pageItems.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" class="text-center py-8 text-slate-500 font-medium">No products found matching "${catalogSearchQuery}".</td></tr>`;
      } else {
        pageItems.forEach(p => {
          const isSub = !!p.is_subscription;
          const isHw = p.category === 'Hardware';
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-800/40 transition-colors';
          tr.innerHTML = `
            <td class="px-4 py-2.5 font-semibold text-white">
              <div class="flex flex-col leading-tight">
                <span class="text-xs font-bold text-white">${p.name}</span>
                <span class="text-[10px] font-mono text-slate-400 mt-0.5">${p.sku || ''}</span>
              </div>
            </td>
            <td class="px-3 py-2.5">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
                isHw ? 'bg-blue-500/20 text-blue-300 border border-blue-500/40' : 'bg-purple-500/20 text-purple-300 border border-purple-500/40'
              }">
                ${p.category}
              </span>
            </td>
            <td class="px-3 py-2.5 text-right font-mono font-bold text-white text-xs">$${Number(p.price).toLocaleString()}</td>
            <td class="px-3 py-2.5 text-center">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
                isSub ? 'bg-amber-500/20 text-amber-300' : 'bg-slate-800 text-slate-400'
              }">
                ${isSub ? 'Recurring SaaS' : 'One-Time Outlay'}
              </span>
            </td>
          `;
          tbody.appendChild(tr);
        });
      }

      // Render pagination controls
      if (controlsEl) {
        controlsEl.innerHTML = '';

        // Prev Button
        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.className = `px-2.5 py-1 rounded-lg border border-slate-700 text-xs font-bold transition-all ${
          catalogPage > 1 ? 'hover:bg-slate-800 text-slate-200 cursor-pointer' : 'text-slate-600 opacity-40 cursor-not-allowed'
        }`;
        prevBtn.textContent = '← Prev';
        prevBtn.disabled = catalogPage === 1;
        prevBtn.onclick = () => {
          if (catalogPage > 1) {
            catalogPage--;
            renderCatalog();
          }
        };
        controlsEl.appendChild(prevBtn);

        // Smart numerical page buttons
        let startP = Math.max(1, catalogPage - 2);
        let endP = Math.min(totalPages, startP + 4);
        if (endP - startP < 4) startP = Math.max(1, endP - 4);

        if (startP > 1) {
          const firstBtn = document.createElement('button');
          firstBtn.type = 'button';
          firstBtn.className = 'w-7 h-7 rounded-lg text-xs font-bold border border-slate-700 text-slate-300 hover:bg-slate-800 cursor-pointer';
          firstBtn.textContent = '1';
          firstBtn.onclick = () => { catalogPage = 1; renderCatalog(); };
          controlsEl.appendChild(firstBtn);

          if (startP > 2) {
            const ellipsis = document.createElement('span');
            ellipsis.className = 'px-1 text-slate-600 text-xs';
            ellipsis.textContent = '...';
            controlsEl.appendChild(ellipsis);
          }
        }

        for (let p = startP; p <= endP; p++) {
          const pBtn = document.createElement('button');
          pBtn.type = 'button';
          pBtn.className = `w-7 h-7 rounded-lg text-xs font-bold transition-all cursor-pointer ${
            p === catalogPage
              ? 'bg-sky-400 text-slate-950 shadow-md ring-1 ring-sky-300'
              : 'border border-slate-700 text-slate-300 hover:bg-slate-800'
          }`;
          pBtn.textContent = p;
          pBtn.onclick = () => {
            catalogPage = p;
            renderCatalog();
          };
          controlsEl.appendChild(pBtn);
        }

        if (endP < totalPages) {
          if (endP < totalPages - 1) {
            const ellipsis = document.createElement('span');
            ellipsis.className = 'px-1 text-slate-600 text-xs';
            ellipsis.textContent = '...';
            controlsEl.appendChild(ellipsis);
          }

          const lastBtn = document.createElement('button');
          lastBtn.type = 'button';
          lastBtn.className = 'w-7 h-7 rounded-lg text-xs font-bold border border-slate-700 text-slate-300 hover:bg-slate-800 cursor-pointer';
          lastBtn.textContent = totalPages;
          lastBtn.onclick = () => { catalogPage = totalPages; renderCatalog(); };
          controlsEl.appendChild(lastBtn);
        }

        // Next Button
        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.className = `px-2.5 py-1 rounded-lg border border-slate-700 text-xs font-bold transition-all ${
          catalogPage < totalPages ? 'hover:bg-slate-800 text-slate-200 cursor-pointer' : 'text-slate-600 opacity-40 cursor-not-allowed'
        }`;
        nextBtn.textContent = 'Next →';
        nextBtn.disabled = catalogPage === totalPages;
        nextBtn.onclick = () => {
          if (catalogPage < totalPages) {
            catalogPage++;
            renderCatalog();
          }
        };
        controlsEl.appendChild(nextBtn);
      }
    }

    window.filterCatalog = function() {
      const input = document.getElementById('catalogSearchInput');
      catalogSearchQuery = input ? input.value : '';
      catalogPage = 1;
      renderCatalog();
    };

    const defaultDemoUsers = [
      { id: 1, name: "Alex Johnson", email: "alex@dealflow360.com", role: "Sales Rep", created_at: "2026-09-01T09:00:00Z" },
      { id: 2, name: "Sarah Chen", email: "sarah@dealflow360.com", role: "Sales Manager", created_at: "2026-09-01T09:00:00Z" },
      { id: 3, name: "Michael Rodriguez", email: "michael@dealflow360.com", role: "Finance", created_at: "2026-09-01T09:00:00Z" },
      { id: 4, name: "Admin User", email: "admin@dealflow360.com", role: "Admin", created_at: "2026-09-01T09:00:00Z" },
      { id: 5, name: "Acme Corporation", email: "contact@acmecorp.com", role: "Customer", created_at: "2026-09-02T10:30:00Z" }
    ];

    let allUsersList = [];

    function getRoleBadge(role) {
      switch(role) {
        case 'Admin':
          return '<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-sky-500/20 text-sky-300 border border-sky-500/40">Admin</span>';
        case 'Sales Manager':
          return '<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">Sales Manager</span>';
        case 'Finance':
          return '<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/40">Finance</span>';
        case 'Sales Rep':
          return '<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-blue-500/20 text-blue-300 border border-blue-500/40">Sales Rep</span>';
        case 'Customer':
        default:
          return '<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">Customer</span>';
      }
    }

    async function loadUsers() {
      // 1. Try fetching from backend API
      try {
        const res = await fetch('http://localhost:8000/api/auth/users');
        if (res.ok) {
          allUsersList = await res.json();
        }
      } catch(e) {
        console.warn('Backend unavailable, using local users storage');
      }

      // 2. Merge with localStorage registered users
      let localUsers = [];
      try {
        localUsers = JSON.parse(localStorage.getItem('dealflow360_all_users') || '[]');
      } catch(e) {}

      if (allUsersList.length === 0) {
        allUsersList = [...defaultDemoUsers];
      }

      // Merge local additions or overrides
      localUsers.forEach(lu => {
        const idx = allUsersList.findIndex(u => u.email.toLowerCase() === lu.email.toLowerCase());
        if (idx >= 0) {
          allUsersList[idx].role = lu.role;
        } else {
          allUsersList.push(lu);
        }
      });

      renderUserTable();
    }

    function renderUserTable() {
      const tbody = document.getElementById('userTableBody');
      const countBadge = document.getElementById('userCountBadge');
      if (!tbody) return;

      countBadge.textContent = `${allUsersList.length} Accounts Registered`;

      // Check current user role
      let currentRole = 'Sales Rep';
      try {
        const u = JSON.parse(localStorage.getItem('dealflow360_user') || '{}');
        if (u.role) currentRole = u.role;
      } catch(e) {}

      const isAdmin = currentRole === 'Admin';
      const statusBanner = document.getElementById('adminStatusBanner');
      const nonAdminNotice = document.getElementById('nonAdminNotice');

      if (statusBanner) {
        if (isAdmin) {
          statusBanner.innerHTML = `
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Admin Role Assignment Authorized
            </span>
          `;
          if (nonAdminNotice) nonAdminNotice.classList.add('hidden');
        } else {
          statusBanner.innerHTML = `
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">
              Read-Only (${currentRole})
            </span>
          `;
          if (nonAdminNotice) nonAdminNotice.classList.remove('hidden');
        }
      }

      const roles = ["Customer", "Sales Rep", "Sales Manager", "Finance", "Admin"];

      tbody.innerHTML = allUsersList.map(user => {
        return `
          <tr class="hover:bg-slate-800/40 transition-colors" data-user-id="${user.id}">
            <td class="px-5 py-3">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center font-bold text-xs text-sky-400">
                  ${user.name ? user.name.charAt(0).toUpperCase() : 'U'}
                </div>
                <div>
                  <div class="font-bold text-white text-xs sm:text-sm">${user.name || 'User'}</div>
                  <div class="text-[10px] text-slate-500">ID #${user.id}</div>
                </div>
              </div>
            </td>
            <td class="px-5 py-3 text-slate-300 font-mono text-xs">${user.email}</td>
            <td class="px-5 py-3" id="roleBadge_${user.id}">
              ${getRoleBadge(user.role)}
            </td>
            <td class="px-5 py-3">
              <select
                id="roleSelect_${user.id}"
                class="bg-slate-800 border border-slate-700 text-white text-xs rounded-lg px-2.5 py-1.5 focus:ring-2 focus:ring-sky-400 focus:outline-none ${!isAdmin ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'}"
                ${!isAdmin ? 'disabled' : ''}
              >
                ${roles.map(r => `<option value="${r}" ${r === user.role ? 'selected' : ''}>${r}</option>`).join('')}
              </select>
            </td>
            <td class="px-5 py-3 text-right">
              <button
                type="button"
                onclick="updateRole(${user.id})"
                class="px-3.5 py-1.5 bg-sky-400 hover:bg-sky-300 text-slate-950 text-xs font-bold rounded-lg transition-all active:scale-95 shadow-sm ${!isAdmin ? 'opacity-40 cursor-not-allowed pointer-events-none' : 'cursor-pointer'}"
                ${!isAdmin ? 'disabled' : ''}
              >
                Assign Role
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    window.updateRole = async function(userId) {
      const select = document.getElementById(`roleSelect_${userId}`);
      if (!select) return;
      const newRole = select.value;

      // 1. Send update to backend API
      try {
        const response = await fetch(`http://localhost:8000/api/auth/users/${userId}/role`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: newRole })
        });
        if (response.ok) {
          const resData = await response.json();
          console.log('Role updated on backend:', resData);
        }
      } catch(e) {
        console.warn('Backend unavailable, updating locally');
      }

      // 2. Update allUsersList
      const user = allUsersList.find(u => u.id === userId);
      if (user) {
        user.role = newRole;

        // 3. Persist to dealflow360_all_users
        let localUsers = [];
        try {
          localUsers = JSON.parse(localStorage.getItem('dealflow360_all_users') || '[]');
        } catch(e) {}
        const idx = localUsers.findIndex(u => u.email.toLowerCase() === user.email.toLowerCase());
        if (idx >= 0) {
          localUsers[idx].role = newRole;
        } else {
          localUsers.push({ ...user, role: newRole });
        }
        localStorage.setItem('dealflow360_all_users', JSON.stringify(localUsers));

        // 4. If this user is currently active session, update their active user object too
        try {
          const currentUser = JSON.parse(localStorage.getItem('dealflow360_user') || '{}');
          if (currentUser.email && currentUser.email.toLowerCase() === user.email.toLowerCase()) {
            currentUser.role = newRole;
            localStorage.setItem('dealflow360_user', JSON.stringify(currentUser));
          }
        } catch(e) {}

        // 5. Update badge UI
        const badgeCell = document.getElementById(`roleBadge_${userId}`);
        if (badgeCell) {
          badgeCell.innerHTML = getRoleBadge(newRole);
        }

        if (window.showToast) {
          window.showToast(`Updated ${user.name}'s role to ${newRole}`, 'success');
        }
      }
    };

    document.addEventListener('DOMContentLoaded', () => {
      renderCatalog();
      loadUsers();
    });
  </script>
</Layout>