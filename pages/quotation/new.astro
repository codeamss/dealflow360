---
import Layout from '../../Layout.astro';
import QuotationBuilder from '../../components/QuotationBuilder.jsx';
import ApprovalPanel from '../../components/ApprovalPanel.jsx';
import FulfillmentSplitter from '../../components/FulfillmentSplitter.jsx';
---

<Layout title="DealFlow360 - Quotation Studio" activeModule="Product">
  <div class="space-y-6 max-w-[1500px] mx-auto">
    
    <!-- Header with Workflow Tabs -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="/pipeline" class="text-xs text-sky-400 hover:text-sky-300 font-semibold">← Pipeline</a>
          <span class="text-xs text-slate-500">/</span>
          <span class="text-xs text-slate-400 font-medium">New Quotation</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Quotation Studio</h1>
        <p class="text-sm text-slate-400 mt-0.5">Build pricing proposals, test approval conditions, and split fulfillment</p>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex items-center bg-slate-800 p-1 rounded-xl border border-slate-700 shadow-sm text-xs font-semibold" id="workflowTabGroup">
        <button 
          type="button" 
          class="workflow-tab active px-4 py-2 rounded-lg bg-sky-400 text-slate-950 font-bold shadow-md transition-all"
          data-target="tab-builder"
        >
          1. Quote Builder
        </button>
        <button 
          type="button" 
          class="workflow-tab px-4 py-2 rounded-lg text-slate-300 hover:text-white transition-all font-semibold"
          data-target="tab-approvals"
        >
          2. Approval Engine
        </button>
        <button 
          type="button" 
          class="workflow-tab px-4 py-2 rounded-lg text-slate-300 hover:text-white transition-all font-semibold"
          data-target="tab-fulfillment"
        >
          3. Multi-Warehouse Split
        </button>
      </div>
    </div>

    <!-- Tab 1: Main Builder -->
    <div id="tab-builder" class="tab-pane block">
      <QuotationBuilder client:load />
    </div>

    <!-- Tab 2: Approval Engine Simulation -->
    <div id="tab-approvals" class="tab-pane hidden">
      <ApprovalPanel client:load />
    </div>

    <!-- Tab 3: Fulfillment Splitter Simulation -->
    <div id="tab-fulfillment" class="tab-pane hidden">
      <FulfillmentSplitter client:load />
    </div>

  </div>

  <script is:inline>
    // Tab Switching Logic
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.workflow-tab');
      const panes = document.querySelectorAll('.tab-pane');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-target');

          // Reset tabs styling
          tabs.forEach(t => {
            t.classList.remove('bg-sky-400', 'text-slate-950', 'font-bold', 'shadow-md');
            t.classList.add('text-slate-300');
          });

          // Set active tab
          tab.classList.add('bg-sky-400', 'text-slate-950', 'font-bold', 'shadow-md');
          tab.classList.remove('text-slate-300');

          // Toggle panes
          panes.forEach(p => {
            if (p.id === target) {
              p.classList.remove('hidden');
              p.classList.add('block');
            } else {
              p.classList.add('hidden');
              p.classList.remove('block');
            }
          });
        });
      });
    });
  </script>
</Layout>