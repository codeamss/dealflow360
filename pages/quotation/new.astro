---
import Layout from '../../Layout.astro';
import QuotationBuilder from '../../components/QuotationBuilder.jsx';
import ApprovalPanel from '../../components/ApprovalPanel.jsx';
import FulfillmentSplitter from '../../components/FulfillmentSplitter.jsx';
---

<Layout title="DealFlow360 - New Quotation">
  <div class="quotation-page">
    <header>
      <h1>Build New Quotation</h1>
      <p>Create a new quote with product selection, discounts, and upsell suggestions</p>
    </header>
    
    <div class="quotation-content">
      <div class="builder-section">
        <QuotationBuilder client:load quotationId={null} />
      </div>
      
      <div class="actions-section">
        <div class="action-panel">
          <h3>Quick Actions</h3>
          <button class="btn-save">Save Draft</button>
          <button class="btn-calculate">Calculate Risk Score</button>
          <button class="btn-send">Send to Customer</button>
          <button class="btn-approve">Request Approval</button>
        </div>
        
        <div class="demo-panels">
          <div class="demo-panel">
            <h4>Approval Preview</h4>
            <p>Create a quote first to see approval panel</p>
            <ApprovalPanel client:load quotationId={null} />
          </div>
          
          <div class="demo-panel">
            <h4>Fulfillment Preview</h4>
            <p>Create a quote first to see fulfillment options</p>
            <FulfillmentSplitter client:load quotationId={null} />
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .quotation-page {
      padding: 2rem;
    }
    
    .quotation-page header {
      margin-bottom: 2rem;
    }
    
    .quotation-page header h1 {
      margin-bottom: 0.5rem;
    }
    
    .quotation-page header p {
      color: #666;
      font-size: 1.125rem;
    }
    
    .quotation-content {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 2rem;
    }
    
    @media (max-width: 1024px) {
      .quotation-content {
        grid-template-columns: 1fr;
      }
    }
    
    .builder-section {
      background: white;
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 1.5rem;
    }
    
    .actions-section {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    
    .action-panel {
      background: white;
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 1.5rem;
    }
    
    .action-panel h3 {
      margin-bottom: 1rem;
    }
    
    .action-panel button {
      display: block;
      width: 100%;
      padding: 0.75rem;
      margin-bottom: 0.75rem;
      border: none;
      border-radius: 4px;
      background: #2c3e50;
      color: white;
      font-weight: 500;
      cursor: pointer;
    }
    
    .action-panel button:hover {
      background: #34495e;
    }
    
    .action-panel .btn-calculate {
      background: #f39c12;
    }
    
    .action-panel .btn-calculate:hover {
      background: #e67e22;
    }
    
    .action-panel .btn-send {
      background: #3498db;
    }
    
    .action-panel .btn-send:hover {
      background: #2980b9;
    }
    
    .action-panel .btn-approve {
      background: #2ecc71;
    }
    
    .action-panel .btn-approve:hover {
      background: #27ae60;
    }
    
    .demo-panels {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    
    .demo-panel {
      background: white;
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 1.5rem;
    }
    
    .demo-panel h4 {
      margin-top: 0;
      margin-bottom: 1rem;
    }
    
    .demo-panel p {
      color: #666;
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }
  </style>
</Layout>