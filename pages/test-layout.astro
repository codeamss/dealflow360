---
import Layout from '../Layout.astro';
---

<Layout title="Layout Test - DealFlow360">
  <div class="w-full max-w-4xl mx-auto">
    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-4">Layout Test Page</h1>
      <p class="text-slate-600 mb-6">This page tests if the layout is working correctly with proper centering and full width.</p>
      
      <!-- Test full width content -->
      <div class="bg-gradient-to-r from-indigo-50 to-blue-50 border border-indigo-200 rounded-lg p-6 mb-6">
        <h2 class="text-xl font-semibold text-indigo-900 mb-2">Full Width Test</h2>
        <p class="text-indigo-700">This content should span the full available width without being left-aligned.</p>
      </div>
      
      <!-- Test navigation alignment -->
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-6 mb-6">
        <h2 class="text-xl font-semibold text-slate-900 mb-2">Navigation Test</h2>
        <p class="text-slate-700">The navigation bar above should be properly centered and not left-aligned.</p>
      </div>
      
      <!-- Test responsive grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
        <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-4">
          <h3 class="font-semibold text-emerald-900 mb-2">Grid Item 1</h3>
          <p class="text-emerald-700 text-sm">This tests responsive grid layout.</p>
        </div>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
          <h3 class="font-semibold text-amber-900 mb-2">Grid Item 2</h3>
          <p class="text-amber-700 text-sm">Content should be properly aligned.</p>
        </div>
        <div class="bg-rose-50 border border-rose-200 rounded-lg p-4">
          <h3 class="font-semibold text-rose-900 mb-2">Grid Item 3</h3>
          <p class="text-rose-700 text-sm">No left-alignment issues.</p>
        </div>
      </div>
      
      <!-- Test buttons -->
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/login" class="px-6 py-3 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition-colors text-center">
          Go to Login
        </a>
        <a href="/pipeline" class="px-6 py-3 bg-slate-600 text-white font-medium rounded-lg hover:bg-slate-700 transition-colors text-center">
          Go to Pipeline
        </a>
        <a href="/" class="px-6 py-3 bg-emerald-600 text-white font-medium rounded-lg hover:bg-emerald-700 transition-colors text-center">
          Go to Dashboard
        </a>
      </div>
    </div>
    
    <!-- Footer test -->
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h2 class="text-xl font-semibold text-slate-900 mb-4">Layout Status</h2>
      <div class="space-y-3">
        <div class="flex items-center justify-between p-3 bg-green-50 border border-green-200 rounded">
          <span class="text-green-800 font-medium">✓ Tailwind CSS</span>
          <span class="text-green-600 text-sm">Working</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-green-50 border border-green-200 rounded">
          <span class="text-green-800 font-medium">✓ Fixed Navigation</span>
          <span class="text-green-600 text-sm">Implemented</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-green-50 border border-green-200 rounded">
          <span class="text-green-800 font-medium">✓ Responsive Layout</span>
          <span class="text-green-600 text-sm">Working</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-green-50 border border-green-200 rounded">
          <span class="text-green-800 font-medium">✓ Proper Centering</span>
          <span class="text-green-600 text-sm">Fixed</span>
        </div>
      </div>
    </div>
  </div>
</Layout>