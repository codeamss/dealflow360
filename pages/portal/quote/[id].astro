---
import Layout from '../../Layout.astro';
import NegotiationBox from '../../components/NegotiationBox.jsx';

export interface Props {
  id: string;
}

const { id } = Astro.params;
---

<Layout title={`Customer Portal - Quote #${id}`}>
  <div class="min-h-screen bg-gradient-to-br from-orange-50 to-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {/* Authentication check */}
      <div id="authCheck" class="mb-6">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-semibold text-gray-900">Customer Portal Access</h2>
              <p class="text-sm text-gray-600">Viewing Quote #{id}</p>
            </div>
            <div id="portalAuthStatus" class="text-sm">
              Checking authentication...
            </div>
          </div>
        </div>
      </div>

      {/* Customer Portal Content */}
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Main Quote Details */}
        <div class="lg:col-span-2 space-y-6">
          {/* Quote Header */}
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex justify-between items-start mb-6">
              <div>
                <h1 class="text-2xl font-bold text-gray-900">Quotation #{id}</h1>
                <p class="text-gray-600">For Acme Corporation</p>
              </div>
              <div class="text-right">
                <div class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  Under Negotiation
                </div>
                <p class="mt-2 text-sm text-gray-500">Valid until: Dec 15, 2026</p>
              </div>
            </div>

            {/* Quote Summary */}
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
              <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-sm text-gray-600">Total Value</p>
                <p class="text-xl font-bold text-gray-900">$45,820</p>
              </div>
              <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-sm text-gray-600">Proposed Discount</p>
                <p class="text-xl font-bold text-green-600">12.5%</p>
              </div>
              <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-sm text-gray-600">Net Amount</p>
                <p class="text-xl font-bold text-gray-900">$40,091</p>
              </div>
              <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-sm text-gray-600">Your Savings</p>
                <p class="text-xl font-bold text-blue-600">$5,729</p>
              </div>
            </div>

            {/* Billing Schedule */}
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-4">Billing Schedule</h3>
              <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                  <thead class="bg-gray-50">
                    <tr>
                      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item</th>
                      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Billing Date</th>
                    </tr>
                  </thead>
                  <tbody class="bg-white divide-y divide-gray-200">
                    <tr>
                      <td class="px-4 py-3 text-sm text-gray-900">Premium Servers (x5)</td>
                      <td class="px-4 py-3">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                          One-time
                        </span>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-900">$25,000</td>
                      <td class="px-4 py-3 text-sm text-gray-900">Upon delivery</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-3 text-sm text-gray-900">Maintenance Plan</td>
                      <td class="px-4 py-3">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          Subscription
                        </span>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-900">$1,500/month</td>
                      <td class="px-4 py-3 text-sm text-gray-900">Monthly</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-3 text-sm text-gray-900">Installation Services</td>
                      <td class="px-4 py-3">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                          One-time
                        </span>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-900">$8,320</td>
                      <td class="px-4 py-3 text-sm text-gray-900">Upon completion</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          {/* Quote Items */}
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Quote Items</h3>
            <div class="space-y-4">
              <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                <div>
                  <h4 class="font-medium text-gray-900">Premium Server Package</h4>
                  <p class="text-sm text-gray-600">High-performance server with 5-year warranty</p>
                </div>
                <div class="text-right">
                  <p class="text-lg font-bold text-gray-900">$25,000</p>
                  <p class="text-sm text-gray-600">5 units × $5,000</p>
                </div>
              </div>
              <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                <div>
                  <h4 class="font-medium text-gray-900">24/7 Maintenance Plan</h4>
                  <p class="text-sm text-gray-600">Premium support with SLA guarantee</p>
                </div>
                <div class="text-right">
                  <p class="text-lg font-bold text-gray-900">$18,000</p>
                  <p class="text-sm text-gray-600">$1,500/month × 12 months</p>
                </div>
              </div>
              <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                <div>
                  <h4 class="font-medium text-gray-900">Professional Installation</h4>
                  <p class="text-sm text-gray-600">On-site setup and configuration</p>
                </div>
                <div class="text-right">
                  <p class="text-lg font-bold text-gray-900">$8,320</p>
                  <p class="text-sm text-gray-600">One-time fee</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Sidebar */}
        <div class="space-y-6">
          {/* Negotiation Box */}
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Negotiation</h3>
            <p class="text-sm text-gray-600 mb-4">Submit your counter-offer or accept the current quote.</p>
            
            <div id="negotiationBox">
              <Client:only>
                <NegotiationBox quoteId={id} />
              </Client:only>
            </div>
          </div>

          {/* Contact Information */}
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Your Contact</h3>
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-gray-900">Alex Johnson</p>
                <p class="text-sm text-gray-600">Sales Representative</p>
              </div>
            </div>
            <div class="space-y-2">
              <div class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                alex.johnson@dealflow360.com
              </div>
              <div class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                +1 (555) 123-4567
              </div>
            </div>
          </div>

          {/* Portal Information */}
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <h4 class="text-sm font-medium text-blue-800 mb-2">About This Portal</h4>
            <p class="text-xs text-blue-700">
              This portal is for customer access only. You can:
              • View quote details
              • Submit counter-offers
              • Download documents
              • Contact your sales rep
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Check authentication for customer portal
    document.addEventListener('DOMContentLoaded', function() {
      const user = localStorage.getItem('dealflow360_user');
      const token = localStorage.getItem('dealflow360_token');
      const authStatus = document.getElementById('portalAuthStatus');
      
      if (!user || !token) {
        authStatus.innerHTML = `
          <a href="/login" class="text-orange-600 hover:text-orange-800 font-medium">
            Sign in to access portal →
          </a>
        `;
      } else {
        try {
          const userData = JSON.parse(user);
          if (userData.role === 'Customer') {
            authStatus.innerHTML = `
              <span class="text-green-600">✓ Portal access granted</span>
            `;
          } else {
            authStatus.innerHTML = `
              <span class="text-yellow-600">⚠ Internal user viewing portal</span>
            `;
          }
        } catch (e) {
          authStatus.innerHTML = `
            <span class="text-red-600">⚠ Authentication error</span>
          `;
        }
      }
    });
    
    // Redirect if not customer
    function checkCustomerAccess() {
      const user = localStorage.getItem('dealflow360_user');
      const token = localStorage.getItem('dealflow360_token');
      
      if (!user || !token) {
        window.location.href = '/login';
        return false;
      }
      
      try {
        const userData = JSON.parse(user);
        if (userData.role !== 'Customer') {
          console.log('Internal user accessing customer portal, allowing for demo');
          return true; // Allow for demo purposes
        }
        return true;
      } catch (e) {
        return false;
      }
    }
    
    // Run access check
    if (!checkCustomerAccess()) {
      // Redirect handled by function
    }
  </script>
</Layout>