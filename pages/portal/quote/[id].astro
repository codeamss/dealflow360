---
import Layout from '../../../Layout.astro';
import NegotiationBox from '../../../components/NegotiationBox.jsx';
import { quotations, products } from '../../../mockData.js';

export function getStaticPaths() {
  return [
    { params: { id: '1001' } },
    { params: { id: '1002' } },
    { params: { id: '1003' } },
    { params: { id: '1004' } },
    { params: { id: '1005' } },
  ];
}


export interface Props {
  id: string;
}

const { id } = Astro.params;

// Find quotation matching ID, or default to first quote
const targetId = parseInt(id || '1001');
const quote = quotations.find(q => q.id === targetId) || quotations[0];

// Compute summary financials
let totalGross = 0;
let totalNet = 0;

const quoteLines = (quote.lines || []).map((line, idx) => {
  const prod = line.product || products.find(p => p.id === line.product_id) || {
    id: line.product_id,
    name: `Item #${line.product_id}`,
    price: 1000,
    category: 'Hardware',
    is_subscription: false
  };
  const lineGross = prod.price * line.quantity;
  const discountPercent = line.applied_discount || 0;
  const lineNet = lineGross * (1 - discountPercent / 100);
  totalGross += lineGross;
  totalNet += lineNet;

  return {
    id: line.id || idx + 1,
    name: prod.name,
    category: prod.category,
    price: prod.price,
    quantity: line.quantity,
    discount: discountPercent,
    is_subscription: prod.is_subscription,
    totalGross: lineGross,
    totalNet: lineNet
  };
});

if (totalGross === 0) {
  totalGross = quote.total_price || 15000;
  totalNet = quote.total_price ? quote.total_price * 0.9 : 13500;
}
const totalSavings = Math.max(0, totalGross - totalNet);
const blendedDiscountPercent = totalGross > 0 ? ((totalSavings / totalGross) * 100).toFixed(1) : "0.0";
---

<Layout title={`Customer Portal - Quotation #${quote.id}`}>
  <div class="space-y-6">
    
    <!-- Portal Header Banner -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full border border-indigo-100">
              Customer Executive Portal
            </span>
            <span class="text-xs text-slate-400">•</span>
            <span class="text-xs text-slate-500 font-mono">Ref: DF-{quote.id}</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Quotation #{quote.id}</h1>
          <p class="text-sm text-slate-600 mt-0.5">Prepared exclusively for <strong class="text-slate-800 font-semibold">{quote.customer_name}</strong></p>
        </div>

        <div class="flex sm:flex-col items-center sm:items-end justify-between w-full sm:w-auto gap-2">
          <div class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border ${
            quote.status === 'Confirmed' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
            quote.status === 'Negotiation' ? 'bg-orange-50 text-orange-700 border-orange-200' :
            quote.status === 'Pending Approval' ? 'bg-amber-50 text-amber-700 border-amber-200' :
            'bg-blue-50 text-blue-700 border-blue-200'
          }`}>
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            {quote.status}
          </div>
          <span class="text-xs text-slate-500">Valid through: 30 days from creation</span>
        </div>
      </div>
    </div>

    <!-- Main Portal Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Left 2 Cols: Details & Line Items -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Executive KPI Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
            <div class="text-xs font-medium text-slate-500">Total Value</div>
            <div class="text-xl font-bold text-slate-900 mt-1">${Math.round(totalGross).toLocaleString()}</div>
            <div class="text-[11px] text-slate-400 mt-0.5">Standard list price</div>
          </div>
          <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
            <div class="text-xs font-medium text-slate-500">Applied Discount</div>
            <div class="text-xl font-bold text-emerald-600 mt-1">{blendedDiscountPercent}%</div>
            <div class="text-[11px] text-emerald-600 mt-0.5">Approved pricing</div>
          </div>
          <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
            <div class="text-xs font-medium text-slate-500">Total Savings</div>
            <div class="text-xl font-bold text-indigo-600 mt-1">${Math.round(totalSavings).toLocaleString()}</div>
            <div class="text-[11px] text-slate-400 mt-0.5">Commercial discount</div>
          </div>
          <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
            <div class="text-xs font-medium text-slate-500">Net Payable</div>
            <div class="text-xl font-bold text-slate-900 mt-1">${Math.round(totalNet).toLocaleString()}</div>
            <div class="text-[11px] text-slate-500 mt-0.5">Before local tax</div>
          </div>
        </div>

        <!-- Line Items Table -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50/50">
            <div>
              <h3 class="font-semibold text-slate-900 text-sm">Commercial Proposal Details</h3>
              <p class="text-xs text-slate-500">Line items and discount breakdown</p>
            </div>
            <span class="text-xs font-medium bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full border border-slate-200">
              {quoteLines.length} Item{quoteLines.length !== 1 ? 's' : ''}
            </span>
          </div>

          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
              <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                <tr>
                  <th class="px-6 py-3 text-left">Item & Category</th>
                  <th class="px-4 py-3 text-center">Type</th>
                  <th class="px-4 py-3 text-right">Unit Price</th>
                  <th class="px-4 py-3 text-center">Qty</th>
                  <th class="px-4 py-3 text-center">Discount</th>
                  <th class="px-6 py-3 text-right">Net Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 bg-white">
                {quoteLines.map((item) => (
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="px-6 py-4">
                      <div class="font-medium text-slate-900">{item.name}</div>
                      <div class="text-xs text-slate-500 mt-0.5">{item.category}</div>
                    </td>
                    <td class="px-4 py-4 text-center">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium border ${
                        item.is_subscription 
                          ? 'bg-purple-50 text-purple-700 border-purple-200' 
                          : 'bg-blue-50 text-blue-700 border-blue-200'
                      }`}>
                        {item.is_subscription ? 'Subscription' : 'One-time'}
                      </span>
                    </td>
                    <td class="px-4 py-4 text-right text-slate-600 font-mono text-xs">
                      ${item.price.toLocaleString()}
                    </td>
                    <td class="px-4 py-4 text-center font-medium text-slate-800">
                      {item.quantity}
                    </td>
                    <td class="px-4 py-4 text-center">
                      {item.discount > 0 ? (
                        <span class="inline-block px-2 py-0.5 text-xs font-medium text-emerald-700 bg-emerald-50 rounded border border-emerald-100">
                          {item.discount}% off
                        </span>
                      ) : (
                        <span class="text-xs text-slate-400">—</span>
                      )}
                    </td>
                    <td class="px-6 py-4 text-right font-semibold text-slate-900 font-mono">
                      ${Math.round(item.totalNet).toLocaleString()}
                    </td>
                  </tr>
                ))}
              </tbody>
              <tfoot class="bg-slate-50 font-medium">
                <tr>
                  <td colspan="5" class="px-6 py-3 text-right text-xs uppercase tracking-wider text-slate-500">Gross Total:</td>
                  <td class="px-6 py-3 text-right text-slate-700 font-mono">${Math.round(totalGross).toLocaleString()}</td>
                </tr>
                <tr>
                  <td colspan="5" class="px-6 py-2 text-right text-xs uppercase tracking-wider text-emerald-600">Total Discount:</td>
                  <td class="px-6 py-2 text-right text-emerald-600 font-mono">-${Math.round(totalSavings).toLocaleString()}</td>
                </tr>
                <tr class="border-t border-slate-200 text-base font-bold text-slate-900">
                  <td colspan="5" class="px-6 py-4 text-right">Net Proposal Amount:</td>
                  <td class="px-6 py-4 text-right text-indigo-700 font-mono">${Math.round(totalNet).toLocaleString()}</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <!-- Billing & Delivery Schedule -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
          <h3 class="text-base font-semibold text-slate-900 mb-3">Fulfillment & Payment Schedule</h3>
          <div class="space-y-3 text-sm">
            <div class="flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200/80">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs">1</div>
                <div>
                  <div class="font-medium text-slate-900">Initial Hardware Deployment</div>
                  <div class="text-xs text-slate-500">Physical systems dispatched via nearest regional warehouse</div>
                </div>
              </div>
              <span class="text-xs font-semibold text-slate-700 bg-white px-2.5 py-1 rounded-md border border-slate-200">Net 30</span>
            </div>

            <div class="flex items-center justify-between p-3.5 bg-slate-50 rounded-xl border border-slate-200/80">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center font-bold text-xs">2</div>
                <div>
                  <div class="font-medium text-slate-900">Recurring Cloud / Support Services</div>
                  <div class="text-xs text-slate-500">Billed monthly commencing upon system handover</div>
                </div>
              </div>
              <span class="text-xs font-semibold text-slate-700 bg-white px-2.5 py-1 rounded-md border border-slate-200">Monthly</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right 1 Col: Negotiation Box & Rep Contact -->
      <div class="space-y-6">
        
        <!-- Live Negotiation Box -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
          <NegotiationBox client:load quotationId={quote.id} isCustomerView={true} />
        </div>

        <!-- Sales Representative Card -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
          <h3 class="text-sm font-semibold text-slate-900 mb-4">Dedicated Account Representative</h3>
          <div class="flex items-center gap-3.5 mb-4">
            <div class="w-12 h-12 bg-indigo-100 text-indigo-700 rounded-xl flex items-center justify-center font-bold text-base shadow-sm">
              AJ
            </div>
            <div>
              <div class="font-semibold text-slate-900 text-sm">Alex Johnson</div>
              <div class="text-xs text-slate-500">Senior Enterprise Account Executive</div>
            </div>
          </div>

          <div class="space-y-2.5 text-xs text-slate-600 border-t border-slate-100 pt-3">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>alex.johnson@dealflow360.com</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>+1 (555) 234-8901 (Ext. 402)</span>
            </div>
          </div>
        </div>

        <!-- Portal Security Notice -->
        <div class="bg-slate-50 rounded-xl border border-slate-200 p-4 text-xs text-slate-600">
          <div class="flex items-center gap-2 font-semibold text-slate-800 mb-1">
            <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span>Secure B2B Portal</span>
          </div>
          <p class="text-slate-500 leading-relaxed">
            All submitted counter-offers and accepted quotes are encrypted and directly routed to the sales approval committee.
          </p>
        </div>

      </div>
    </div>
  </div>
</Layout>