---
import Layout from '../Layout.astro';
---

<Layout title="Login - DealFlow360">
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-indigo-600 to-blue-600 rounded-2xl shadow-lg mb-6">
          <span class="text-white font-bold text-xl">DF</span>
        </div>
        <h1 class="text-3xl font-bold text-slate-900 mb-2">DealFlow360</h1>
        <p class="text-slate-600 text-sm">
          Sign in to your executive B2B sales platform
        </p>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 hover:shadow-md transition-shadow">
        <!-- Simple Login Form -->
        <form id="login-form" class="space-y-5">
          <div>
            <label for="email" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
              Email address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 placeholder:text-slate-400"
              placeholder="alex@dealflow360.com"
            />
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
              Password
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 placeholder:text-slate-400"
              placeholder="password123"
            />
          </div>

          <div>
            <button
              type="submit"
              class="w-full flex justify-center py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg shadow-sm active:scale-[0.98] transition-all"
            >
              Sign in
            </button>
          </div>

          <div class="text-center pt-2">
            <a href="/register" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium transition-colors">
              Need an account? Register here
            </a>
          </div>
        </form>

        <!-- Demo Login Buttons -->
        <div class="mt-6 pt-6 border-t border-slate-100">
          <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3 text-center">Quick Demo Login</h4>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
            <button type="button" class="demo-login bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 py-2 px-3 rounded-lg text-sm font-medium transition-all" data-role="Sales Rep">
              Sales Rep
            </button>
            <button type="button" class="demo-login bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 py-2 px-3 rounded-lg text-sm font-medium transition-all" data-role="Sales Manager">
              Sales Manager
            </button>
            <button type="button" class="demo-login bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 py-2 px-3 rounded-lg text-sm font-medium transition-all" data-role="Finance">
              Finance
            </button>
            <button type="button" class="demo-login bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 py-2 px-3 rounded-lg text-sm font-medium transition-all" data-role="Admin">
              Admin
            </button>
            <button type="button" class="demo-login bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 py-2 px-3 rounded-lg text-sm font-medium transition-all" data-role="Customer">
              Customer
            </button>
          </div>
        </div>

        <div class="mt-6 pt-6 border-t border-slate-100">
          <div class="bg-slate-50 border border-slate-200 rounded-lg p-4">
            <h3 class="text-sm font-medium text-slate-800 mb-2">Demo Information</h3>
            <ul class="space-y-1 text-xs text-slate-600">
              <li class="flex items-start gap-2">
                <span class="text-indigo-500">•</span>
                <span>Use demo buttons for instant access</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-indigo-500">•</span>
                <span>Internal: email@dealflow360.com / password123</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-indigo-500">•</span>
                <span>Customer: contact@acmecorp.com / customer123</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="mt-8 text-center">
        <p class="text-xs text-slate-400">
          DealFlow360 v2.0 • {new Date().getFullYear()}
        </p>
      </div>
    </div>
  </div>

  <script>
    // Client-side redirect for authenticated users
    if (typeof window !== 'undefined') {
      const user = localStorage.getItem('dealflow360_user');
      const token = localStorage.getItem('dealflow360_token');
      
      if (user && token) {
        // Parse user role for redirect logic
        const userData = JSON.parse(user);
        const isCustomer = userData.role === 'Customer';
        
        if (isCustomer) {
          window.location.href = '/portal/quote/1001';
        } else {
          window.location.href = '/pipeline';
        }
      }

      // Handle form submission
      const loginForm = document.getElementById('login-form');
      if (loginForm) {
        loginForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const email = document.getElementById('email').value;
          const password = document.getElementById('password').value;
          
          // Show loading state
          const submitBtn = loginForm.querySelector('button[type="submit"]');
          const originalText = submitBtn.textContent;
          submitBtn.textContent = 'Signing in...';
          submitBtn.disabled = true;
          
          try {
            // Try backend login first
            const response = await fetch('http://localhost:8000/api/auth/login', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ email, password }),
            });
            
            if (response.ok) {
              const data = await response.json();
              localStorage.setItem('dealflow360_user', JSON.stringify(data.user));
              localStorage.setItem('dealflow360_token', data.access_token);
              
              // Redirect based on role
              if (data.user.role === 'Customer') {
                window.location.href = '/portal/quote/1001';
              } else {
                window.location.href = '/pipeline';
              }
            } else {
              // Fallback to mock authentication
              const isCustomer = email.includes('customer') || email.includes('acme');
              const correctPassword = isCustomer ? 'customer123' : 'password123';
              
              if (password === correctPassword) {
                // Mock user data
                const mockUser = {
                  id: 1,
                  name: email.split('@')[0],
                  email: email,
                  role: isCustomer ? 'Customer' : 'Sales Rep'
                };
                
                localStorage.setItem('dealflow360_user', JSON.stringify(mockUser));
                localStorage.setItem('dealflow360_token', 'mock_token_' + Date.now());
                
                // Redirect based on role
                if (isCustomer) {
                  window.location.href = '/portal/quote/1001';
                } else {
                  window.location.href = '/pipeline';
                }
              } else {
                alert('Invalid credentials. For demo: use password123 for internal users or customer123 for customers.');
              }
            }
          } catch (error) {
            console.error('Login error:', error);
            alert('Login failed. Using mock authentication for demo.');
            
            // Fallback mock login
            const isCustomer = email.includes('customer') || email.includes('acme');
            const correctPassword = isCustomer ? 'customer123' : 'password123';
            
            if (password === correctPassword) {
              const mockUser = {
                id: 1,
                name: email.split('@')[0],
                email: email,
                role: isCustomer ? 'Customer' : 'Sales Rep'
              };
              
              localStorage.setItem('dealflow360_user', JSON.stringify(mockUser));
              localStorage.setItem('dealflow360_token', 'mock_token_' + Date.now());
              
              if (isCustomer) {
                window.location.href = '/portal/quote/1001';
              } else {
                window.location.href = '/pipeline';
              }
            } else {
              alert('Invalid credentials. For demo: use password123 for internal users or customer123 for customers.');
            }
          } finally {
            // Reset button
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
          }
        });
      }

      // Handle demo login buttons
      document.querySelectorAll('.demo-login').forEach(button => {
        button.addEventListener('click', () => {
          const role = button.getAttribute('data-role');
          let email, password;
          
          switch(role) {
            case 'Sales Rep':
              email = 'alex@dealflow360.com';
              password = 'password123';
              break;
            case 'Sales Manager':
              email = 'sarah@dealflow360.com';
              password = 'password123';
              break;
            case 'Finance':
              email = 'michael@dealflow360.com';
              password = 'password123';
              break;
            case 'Admin':
              email = 'admin@dealflow360.com';
              password = 'password123';
              break;
            case 'Customer':
              email = 'contact@acmecorp.com';
              password = 'customer123';
              break;
          }
          
          // Auto-fill form
          document.getElementById('email').value = email;
          document.getElementById('password').value = password;
          
          // Submit form
          loginForm.dispatchEvent(new Event('submit'));
        });
      });
    }
  </script>
</Layout>