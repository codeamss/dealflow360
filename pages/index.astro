---
import Layout from '../Layout.astro';
import DealHealthAndReports from '../components/DealHealthAndReports.jsx';
---

<Layout title="DealFlow360 - Sales Dashboard / Home" activeModule="Dashboard">
  <div class="space-y-8 max-w-[1500px] mx-auto">
    
    <!-- Screen 2: Sales Dashboard / Home Top Section -->
    <div class="space-y-4">
      <!-- Title & Subtitle -->
      <div>
        <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">Sales Dashboard / Home</h1>
        <p class="text-slate-400 text-sm mt-1">Central hub, links out to every module below</p>
      </div>

      <!-- 3 KPI Cards matching Screen 2 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Card 1: Pending Approvals -->
        <a href="/approvals" class="bg-slate-800/80 hover:bg-slate-800 border-2 border-slate-700/80 hover:border-sky-400/60 rounded-2xl p-6 transition-all group block shadow-lg">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 group-hover:text-sky-300 transition-colors">
            Pending Approvals
          </div>
          <div class="text-3xl font-black text-white mt-2 font-mono">
            4 <span class="text-base font-normal text-slate-300">quotations waiting</span>
          </div>
          <div class="mt-4 flex items-center text-xs font-semibold text-amber-400">
            <span>Requires Manager / Finance Sign-off</span>
            <span class="ml-1 group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Card 2: Open Quotations -->
        <a href="/pipeline" class="bg-slate-800/80 hover:bg-slate-800 border-2 border-slate-700/80 hover:border-sky-400/60 rounded-2xl p-6 transition-all group block shadow-lg">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 group-hover:text-sky-300 transition-colors">
            Open Quotations
          </div>
          <div class="text-3xl font-black text-white mt-2 font-mono">
            12 <span class="text-base font-normal text-slate-300">active deals</span>
          </div>
          <div class="mt-4 flex items-center text-xs font-semibold text-sky-400">
            <span>Explore Live Sales Pipeline</span>
            <span class="ml-1 group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Card 3: At-Risk Deals -->
        <a href="/deal-health" class="bg-slate-800/80 hover:bg-slate-800 border-2 border-slate-700/80 hover:border-sky-400/60 rounded-2xl p-6 transition-all group block shadow-lg">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 group-hover:text-sky-300 transition-colors">
            At-Risk Deals
          </div>
          <div class="text-3xl font-black text-rose-400 mt-2 font-mono">
            3 <span class="text-base font-normal text-slate-300">flagged by Deal Health</span>
          </div>
          <div class="mt-4 flex items-center text-xs font-semibold text-rose-400">
            <span>Stalled &gt;48h or excessive discount</span>
            <span class="ml-1 group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a 
          href="/quotation/new" 
          class="px-5 py-2.5 bg-sky-400 hover:bg-sky-300 text-slate-950 font-bold rounded-xl text-sm transition-all shadow-md active:scale-95 flex items-center gap-2"
        >
          <span class="text-lg leading-none">+</span>
          <span>New Quotation</span>
        </a>
        <a 
          href="/approvals" 
          class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white border border-slate-600 font-semibold rounded-xl text-sm transition-all active:scale-95"
        >
          View Approvals
        </a>
      </div>

      <!-- Recent Activity Section matching Screen 2 -->
      <div class="bg-slate-800/50 border border-slate-700 rounded-2xl p-6 space-y-3">
        <h3 class="text-lg font-black text-sky-400 tracking-wide">Recent Activity</h3>
        <ul class="space-y-2 text-sm text-slate-300 font-medium">
          <li class="flex items-center gap-2">
            <span class="text-sky-400 font-bold">•</span>
            <span>Acme Corp quotation approved by Finance</span>
            <span class="text-xs text-slate-500 font-mono ml-auto">10m ago</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-sky-400 font-bold">•</span>
            <span>Beta Industries requested a discount change</span>
            <span class="text-xs text-slate-500 font-mono ml-auto">35m ago</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-sky-400 font-bold">•</span>
            <span>East Depot stock updated for Order #2291</span>
            <span class="text-xs text-slate-500 font-mono ml-auto">2h ago</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Quick Navigation to All Core Modules -->
    <div class="space-y-4 pt-4 border-t border-slate-800">
      <div class="flex justify-between items-center">
        <div>
          <h2 class="text-xl font-bold text-white">Platform Modules Hub</h2>
          <p class="text-xs text-slate-400">Direct links to every end-to-end operational module</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/pipeline" class="bg-slate-800/80 hover:bg-slate-800 border border-slate-700 hover:border-sky-400/50 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold text-sm mb-3">
            Q
          </div>
          <div class="font-bold text-white text-sm group-hover:text-sky-300 transition-colors">Quotations (List)</div>
          <div class="text-xs text-slate-400 mt-1">Kanban & Table pipeline tracking</div>
        </a>

        <a href="/approvals" class="bg-slate-800/80 hover:bg-slate-800 border border-slate-700 hover:border-amber-400/50 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-sm mb-3">
            A
          </div>
          <div class="font-bold text-white text-sm group-hover:text-amber-300 transition-colors">Approvals Queue</div>
          <div class="text-xs text-slate-400 mt-1">Blended risk score & multi-gate review</div>
        </a>

        <a href="/fulfillment" class="bg-slate-800/80 hover:bg-slate-800 border border-slate-700 hover:border-emerald-400/50 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm mb-3">
            F
          </div>
          <div class="font-bold text-white text-sm group-hover:text-emerald-300 transition-colors">Fulfillment & Stock</div>
          <div class="text-xs text-slate-400 mt-1">Live warehouse inventory & split orders</div>
        </a>

        <a href="/subscriptions" class="bg-slate-800/80 hover:bg-slate-800 border border-slate-700 hover:border-purple-400/50 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold text-sm mb-3">
            S
          </div>
          <div class="font-bold text-white text-sm group-hover:text-purple-300 transition-colors">Subscriptions</div>
          <div class="text-xs text-slate-400 mt-1">Recurring SaaS, MRR & proration schedules</div>
        </a>

        <a href="/invoices" class="bg-slate-800/80 hover:bg-slate-800 border border-slate-700 hover:border-rose-400/50 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-sm mb-3">
            I
          </div>
          <div class="font-bold text-white text-sm group-hover:text-rose-300 transition-colors">Invoices (List)</div>
          <div class="text-xs text-slate-400 mt-1">Paid vs Unpaid delivery reconciliation</div>
        </a>

        <a href="/deal-health" class="bg-slate-800/80 hover:bg-slate-800 border border-slate-700 hover:border-amber-400/50 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-sm mb-3">
            H
          </div>
          <div class="font-bold text-white text-sm group-hover:text-amber-300 transition-colors">Deal Health</div>
          <div class="text-xs text-slate-400 mt-1">Catches stalled deals &gt;48h & risk spikes</div>
        </a>

        <a href="/reports" class="bg-slate-800/80 hover:bg-slate-800 border border-slate-700 hover:border-sky-400/50 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 rounded-lg bg-sky-500/20 text-sky-400 flex items-center justify-center font-bold text-sm mb-3">
            R
          </div>
          <div class="font-bold text-white text-sm group-hover:text-sky-300 transition-colors">Filtered Reports</div>
          <div class="text-xs text-slate-400 mt-1">Multi-dimensional slicing & CSV exports</div>
        </a>

        <a href="/products" class="bg-slate-800/80 hover:bg-slate-800 border border-slate-700 hover:border-indigo-400/50 rounded-xl p-4 transition-all group">
          <div class="w-9 h-9 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-sm mb-3">
            P
          </div>
          <div class="font-bold text-white text-sm group-hover:text-indigo-300 transition-colors">Product Studio</div>
          <div class="text-xs text-slate-400 mt-1">Upload SKUs, CSV bulk ingest & 220+ catalog</div>
        </a>
      </div>
    </div>

    <!-- Manager Deal Health Matrix & Filtered Reporting Engine Preview -->
    <div class="pt-2">
      <DealHealthAndReports client:load />
    </div>

  </div>
</Layout>