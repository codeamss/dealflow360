---
import Layout from '../Layout.astro';
import { products, warehouses } from '../mockData.js';
---

<Layout title="DealFlow360 - Product Catalog & Upload Studio" activeModule="Product">
  <div class="space-y-8 max-w-[1500px] mx-auto" id="productStudioApp">
    
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="/pipeline" class="text-xs text-sky-400 hover:text-sky-300 font-semibold">← Pipeline</a>
          <span class="text-xs text-slate-500">/</span>
          <span class="text-xs text-slate-400 font-medium">Catalog Studio</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Product Catalog & Upload Studio</h1>
        <p class="text-slate-400 text-xs sm:text-sm mt-0.5">
          Configure commercial price lists, upload new inventory SKUs, and manage 220+ products
        </p>
      </div>

      <!-- Quick Action Tabs -->
      <div class="flex items-center bg-slate-800/90 p-1 rounded-xl border border-slate-700 shadow-sm text-xs font-semibold">
        <button 
          type="button" 
          id="btnTabCatalog"
          onclick="switchTab('catalog')" 
          class="px-4 py-2 rounded-lg bg-sky-400 text-slate-950 font-bold shadow-md transition-all"
        >
          Catalog Table (220+)
        </button>
        <button 
          type="button" 
          id="btnTabUpload"
          onclick="switchTab('upload')" 
          class="px-4 py-2 rounded-lg text-slate-300 hover:text-white transition-all font-semibold"
        >
          + Upload Single Product
        </button>
        <button 
          type="button" 
          id="btnTabBulk"
          onclick="switchTab('bulk')" 
          class="px-4 py-2 rounded-lg text-slate-300 hover:text-white transition-all font-semibold"
        >
          Bulk CSV Import
        </button>
      </div>
    </div>

    <!-- 4 KPI Summary Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-slate-900/90 border border-slate-700/80 rounded-2xl p-5 shadow-lg">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Catalog SKUs</div>
        <div class="text-2xl sm:text-3xl font-black text-white mt-1 font-mono" id="kpiTotalSkus">220+</div>
        <div class="text-[11px] text-sky-400 mt-1 font-medium">✓ Active commercial lines</div>
      </div>

      <div class="bg-slate-900/90 border border-slate-700/80 rounded-2xl p-5 shadow-lg">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Hardware Products</div>
        <div class="text-2xl sm:text-3xl font-black text-blue-400 mt-1 font-mono">110 Lines</div>
        <div class="text-[11px] text-slate-400 mt-1">Servers, switches, racks & client HW</div>
      </div>

      <div class="bg-slate-900/90 border border-slate-700/80 rounded-2xl p-5 shadow-lg">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">SaaS & Services</div>
        <div class="text-2xl sm:text-3xl font-black text-purple-400 mt-1 font-mono">110 Lines</div>
        <div class="text-[11px] text-slate-400 mt-1">Monthly & annual subscriptions</div>
      </div>

      <div class="bg-slate-900/90 border border-slate-700/80 rounded-2xl p-5 shadow-lg">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Warehouse Stock Value</div>
        <div class="text-2xl sm:text-3xl font-black text-emerald-400 mt-1 font-mono">$3.84M</div>
        <div class="text-[11px] text-slate-400 mt-1">Across 4 regional depots</div>
      </div>
    </div>


    <!-- ===================================================================== -->
    <!-- TAB 1: ADD / UPLOAD SINGLE PRODUCT FORM                               -->
    <!-- ===================================================================== -->
    <div id="paneUpload" class="hidden bg-slate-900/95 border-2 border-slate-700 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-sky-400"></span>
          Upload New Product to Commercial Catalog
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          Complete the input fields below. Newly created products immediately synchronize into the Quotation Builder and warehouse inventory matrix.
        </p>
      </div>

      <form id="productForm" onsubmit="window.handleProductSubmit(event); return false;" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          <!-- Product Name -->
          <div class="lg:col-span-2">
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Product Name <span class="text-rose-400">*</span>
            </label>
            <input 
              type="text" 
              id="prodName" 
              required
              placeholder="e.g. Titan Ultra-Dense Fiber Switch 48X" 
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400 transition-all"
            />
          </div>

          <!-- SKU Code -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              SKU / Product Code <span class="text-rose-400">*</span>
            </label>
            <input 
              type="text" 
              id="prodSku" 
              required
              placeholder="e.g. HW-TITAN-48X" 
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400 transition-all uppercase"
            />
          </div>

          <!-- Category -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Product Category <span class="text-rose-400">*</span>
            </label>
            <select 
              id="prodCategory" 
              required
              onchange="handleCategoryChange(this.value)"
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-sky-400"
            >
              <option value="Hardware">Hardware (Server, Storage, Switch, Client)</option>
              <option value="Services">Services (Cloud, Support SLA, Engineering)</option>
              <option value="Software">Software & Cloud Licenses</option>
              <option value="Networking">Networking Infrastructure</option>
              <option value="Security">Cybersecurity & Threat Monitoring</option>
            </select>
          </div>

          <!-- List Price -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              List Selling Price ($) <span class="text-rose-400">*</span>
            </label>
            <div class="relative">
              <span class="absolute left-3.5 top-2.5 text-slate-400 font-mono text-sm">$</span>
              <input 
                type="number" 
                id="prodPrice" 
                required
                min="1" 
                step="0.01" 
                placeholder="4800" 
                oninput="updateMarginPreview()"
                class="w-full bg-slate-800 border border-slate-700 rounded-xl pl-8 pr-4 py-2.5 text-sm text-white font-mono font-bold focus:outline-none focus:ring-2 focus:ring-sky-400"
              />
            </div>
          </div>

          <!-- Unit Cost -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Unit Cost ($) <span class="text-rose-400">*</span>
            </label>
            <div class="relative">
              <span class="absolute left-3.5 top-2.5 text-slate-400 font-mono text-sm">$</span>
              <input 
                type="number" 
                id="prodCost" 
                required
                min="0" 
                step="0.01" 
                placeholder="2900" 
                oninput="updateMarginPreview()"
                class="w-full bg-slate-800 border border-slate-700 rounded-xl pl-8 pr-4 py-2.5 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-sky-400"
              />
            </div>
          </div>

          <!-- Live Margin Calculation Pill -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Estimated Gross Margin
            </label>
            <div id="marginBadge" class="h-[42px] flex items-center px-4 rounded-xl border border-slate-700 bg-slate-800/80 font-mono text-sm font-bold text-slate-400">
              Enter price and cost
            </div>
          </div>

          <!-- Billing Cadence -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Billing Frequency <span class="text-rose-400">*</span>
            </label>
            <select 
              id="prodBilling" 
              required
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-sky-400"
            >
              <option value="One-Time">One-Time Capital Outlay (HW / Setup)</option>
              <option value="monthly">Recurring Monthly (SaaS / Managed)</option>
              <option value="quarterly">Recurring Quarterly</option>
              <option value="annual">Recurring Annual Contract</option>
            </select>
          </div>

          <!-- Unit of Measure (From Hackathon Spec A2) -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Unit of Measure <span class="text-rose-400">*</span>
            </label>
            <select 
              id="prodUnit" 
              required
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-sky-400"
            >
              <option value="each">each (Single physical unit)</option>
              <option value="monthly">monthly (Recurring monthly)</option>
              <option value="annual">annual (Per year subscription)</option>
              <option value="license">license (Per software seat)</option>
              <option value="user">user (Per active user)</option>
              <option value="pack">pack (Multi-item bundle)</option>
            </select>
          </div>

          <!-- Tax Rate % (From Hackathon Spec A2) -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Sales Tax Rate (%)
            </label>
            <div class="relative">
              <input 
                type="number" 
                id="prodTax" 
                min="0" 
                max="30" 
                step="0.5" 
                value="8.0" 
                class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-sky-400 pr-8"
              />
              <span class="absolute right-3.5 top-2.5 text-slate-400 font-mono text-sm">%</span>
            </div>
          </div>

          <!-- Primary Warehouse -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Target Distribution Warehouse
            </label>
            <select 
              id="prodWarehouse" 
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-sky-400"
            >
              <option value="1">Main Central Hub (Dallas, TX)</option>
              <option value="2">East Coast Depot (Newark, NJ)</option>
              <option value="3">West Coast Depot (Oakland, CA)</option>
              <option value="4">Midwest Logistics Facility (Chicago, IL)</option>
            </select>
          </div>

          <!-- Initial Stock Quantity -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Initial Stock Units
            </label>
            <input 
              type="number" 
              id="prodStock" 
              min="0" 
              value="50" 
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-sky-400"
            />
          </div>

          <!-- Description -->
          <div class="lg:col-span-3">
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
              Product Specifications & Descriptions
            </label>
            <textarea 
              id="prodDesc" 
              rows="3" 
              placeholder="Enterprise technical specifications, cooling requirements, or included service levels..."
              class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-sky-400 resize-none"
            ></textarea>
          </div>
        </div>

        <!-- Submit & Quick Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-slate-800">
          <button 
            type="submit" 
            id="btnSaveProduct"
            class="px-6 py-3 bg-sky-400 hover:bg-sky-300 text-slate-950 font-black text-sm rounded-xl shadow-lg transition-all active:scale-95 flex items-center gap-2 cursor-pointer"
          >
            <span>+ Add Product to Catalog</span>
          </button>

          <button 
            type="button" 
            id="btnFillDemo"
            onclick="fillDemoProduct()"
            class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold text-xs rounded-xl border border-amber-500/40 transition-all flex items-center gap-1.5 cursor-pointer"
          >
            <span>⚡ Fill Demo Data</span>
          </button>

          <button 
            type="button" 
            onclick="switchTab('catalog')" 
            class="px-5 py-3 border border-slate-700 hover:bg-slate-800 text-slate-300 text-sm font-semibold rounded-xl transition-all cursor-pointer"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>


    <!-- ===================================================================== -->
    <!-- TAB 2: BULK CSV IMPORT                                                -->
    <!-- ===================================================================== -->
    <div id="paneBulk" class="hidden bg-slate-900/95 border-2 border-slate-700 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
      <div class="border-b border-slate-800 pb-4 flex justify-between items-center">
        <div>
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
            Bulk Catalog CSV Import
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            Upload or paste CSV rows to quickly ingest large volumes of hardware and SaaS items.
          </p>
        </div>
        <button 
          type="button" 
          onclick="downloadSampleCsv()"
          class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-sky-300 text-xs font-semibold rounded-lg border border-slate-700 flex items-center gap-1.5"
        >
          <span>📥 Download Sample CSV</span>
        </button>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
            Paste CSV Data (Format: SKU, Name, Category, Price, Cost, Billing, Stock)
          </label>
          <textarea 
            id="bulkCsvText" 
            rows="7" 
            class="w-full bg-slate-950 border border-slate-700 rounded-xl p-4 text-xs text-slate-200 font-mono focus:outline-none focus:ring-2 focus:ring-sky-400 resize-none"
            placeholder={`HW-EDGE-200,Edge Aggregation Router 200,Hardware,5200,3100,One-Time,35
SVC-SLA-PREM,24/7 Premium Engineering SLA,Services,1450,550,monthly,999
HW-SAN-80TB,Titan NVMe SAN Array 80TB,Hardware,18500,11800,One-Time,12`}
          ></textarea>
        </div>

        <div class="flex items-center gap-4">
          <button 
            type="button" 
            onclick="processBulkCsv()"
            class="px-6 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs rounded-xl shadow-lg transition-all active:scale-95"
          >
            Ingest & Import Products
          </button>
          <span class="text-xs text-slate-400" id="bulkStatusText">Ready to process batch entries</span>
        </div>
      </div>
    </div>


    <!-- ===================================================================== -->
    <!-- TAB 3: FULL PRODUCT CATALOG TABLE (220+ ITEMS & PAGINATION)            -->
    <!-- ===================================================================== -->
    <div id="paneCatalog" class="block bg-slate-900/90 border border-slate-700/80 rounded-2xl p-6 shadow-xl space-y-5">
      <!-- Search & Filters Bar -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex-1 max-w-md">
          <div class="relative">
            <span class="absolute left-3.5 top-2.5 text-slate-400 text-sm">🔍</span>
            <input 
              type="text" 
              id="catalogSearch" 
              oninput="filterCatalog()"
              placeholder="Search 220+ products by name, SKU, or category..." 
              class="w-full bg-slate-800/90 border border-slate-700 rounded-xl pl-9 pr-4 py-2 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-400"
            />
          </div>
        </div>

        <!-- Filter Buttons & + Upload Product Action -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0 flex-shrink-0">
          <button 
            type="button" 
            class="cat-filter active px-3 py-1.5 rounded-lg text-xs font-bold bg-sky-400 text-slate-950 transition-all cursor-pointer"
            data-cat="all"
            onclick="setCategoryFilter('all', this)"
          >
            All Categories (<span id="countAll">220</span>)
          </button>
          <button 
            type="button" 
            class="cat-filter px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300 hover:text-white bg-slate-800 transition-all cursor-pointer"
            data-cat="Hardware"
            onclick="setCategoryFilter('Hardware', this)"
          >
            Hardware
          </button>
          <button 
            type="button" 
            class="cat-filter px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300 hover:text-white bg-slate-800 transition-all cursor-pointer"
            data-cat="Services"
            onclick="setCategoryFilter('Services', this)"
          >
            SaaS & Services
          </button>

          <button 
            type="button" 
            onclick="switchTab('upload')" 
            class="px-3.5 py-1.5 bg-sky-400 hover:bg-sky-300 text-slate-950 font-bold text-xs rounded-lg shadow-sm transition-all flex items-center gap-1 cursor-pointer ml-1"
          >
            <span class="text-sm font-black">+</span>
            <span>Upload Product</span>
          </button>
        </div>
      </div>

      <!-- Catalog Table -->
      <div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-950/40">
        <table class="min-w-full divide-y divide-slate-700 text-xs sm:text-sm">
          <thead class="bg-slate-800/80 text-slate-300 font-bold uppercase tracking-wider text-[10px]">
            <tr>
              <th class="px-4 py-3 text-left">SKU</th>
              <th class="px-4 py-3 text-left">Product Name & Specifications</th>
              <th class="px-3 py-3 text-left">Category</th>
              <th class="px-3 py-3 text-right">List Price</th>
              <th class="px-3 py-3 text-right">Est Cost</th>
              <th class="px-3 py-3 text-center">Gross Margin</th>
              <th class="px-3 py-3 text-center">Billing Type</th>
              <th class="px-3 py-3 text-center">Stock</th>
            </tr>
          </thead>
          <tbody id="catalogTableBody" class="divide-y divide-slate-800 text-slate-300">
            <!-- Dynamic JavaScript rendering with pagination -->
          </tbody>
        </table>
      </div>

      <!-- Pagination Controls Bar (25 items per page) -->
      <div class="flex flex-col sm:flex-row justify-between items-center gap-3 pt-2 text-xs text-slate-400">
        <div id="catalogPaginationInfo">
          Showing 1–25 of 220 items
        </div>

        <div class="flex items-center gap-1.5" id="paginationControls">
          <!-- Dynamically populated page buttons -->
        </div>
      </div>

      <!-- Yellow Callout Box matching Excalidraw Style -->
      <div class="excalidraw-callout">
        All catalog items and newly uploaded products are dynamically accessible inside the Quotation Builder dropdown, margin simulator, and warehouse inventory allocation matrix.
      </div>
    </div>

  </div>

  <script is:inline define:vars={{ initialCatalog: products }}>
    (function() {
      // Embedded Catalog Data loaded from mockData (220+ SKUs)
      let catalogItems = [];
      let currentFilter = 'all';
      let searchQuery = '';
      let currentPage = 1;
      const pageSize = 25;

      // Make state and handlers globally accessible
      window.switchTab = function(tab) {
        const paneCatalog = document.getElementById('paneCatalog');
        const paneUpload = document.getElementById('paneUpload');
        const paneBulk = document.getElementById('paneBulk');

        const btnCatalog = document.getElementById('btnTabCatalog');
        const btnUpload = document.getElementById('btnTabUpload');
        const btnBulk = document.getElementById('btnTabBulk');

        [btnCatalog, btnUpload, btnBulk].forEach(b => {
          if (b) {
            b.classList.remove('bg-sky-400', 'text-slate-950', 'font-bold', 'shadow-md');
            b.classList.add('text-slate-300');
          }
        });

        if (paneCatalog) paneCatalog.classList.add('hidden');
        if (paneUpload) paneUpload.classList.add('hidden');
        if (paneBulk) paneBulk.classList.add('hidden');

        if (tab === 'upload') {
          if (paneUpload) paneUpload.classList.remove('hidden');
          if (btnUpload) {
            btnUpload.classList.add('bg-sky-400', 'text-slate-950', 'font-bold', 'shadow-md');
            btnUpload.classList.remove('text-slate-300');
          }
        } else if (tab === 'bulk') {
          if (paneBulk) paneBulk.classList.remove('hidden');
          if (btnBulk) {
            btnBulk.classList.add('bg-sky-400', 'text-slate-950', 'font-bold', 'shadow-md');
            btnBulk.classList.remove('text-slate-300');
          }
        } else {
          if (paneCatalog) paneCatalog.classList.remove('hidden');
          if (btnCatalog) {
            btnCatalog.classList.add('bg-sky-400', 'text-slate-950', 'font-bold', 'shadow-md');
            btnCatalog.classList.remove('text-slate-300');
          }
          window.renderCatalog();
        }
      };

      // Load initial products from local storage merged with mock products
      window.loadCatalogData = function() {
        let storedCustom = [];
        try {
          const raw = localStorage.getItem('dealflow360_custom_products');
          if (raw) storedCustom = JSON.parse(raw);
        } catch (e) {}

        const seenIds = new Set();
        const seenSkus = new Set();
        const merged = [];

        // 1. Put custom uploaded products at the top
        storedCustom.forEach(p => {
          p.is_custom = true;
          merged.push(p);
          if (p.id) seenIds.add(String(p.id));
          if (p.sku) seenSkus.add(String(p.sku).toUpperCase());
        });

        // 2. Add base mock items
        (initialCatalog || []).forEach(p => {
          if (!seenIds.has(String(p.id)) && (!p.sku || !seenSkus.has(String(p.sku).toUpperCase()))) {
            merged.push(p);
          }
        });

        catalogItems = merged;

        // 3. Optional async sync if backend API is online
        fetch('http://localhost:8000/api/products')
          .then(res => res.json())
          .then(apiProducts => {
            if (Array.isArray(apiProducts) && apiProducts.length > 5) {
              const apiMerged = [...storedCustom];
              const apiSeen = new Set(storedCustom.map(c => String(c.id)));
              apiProducts.forEach(p => {
                if (!apiSeen.has(String(p.id))) {
                  apiMerged.push(p);
                }
              });
              catalogItems = apiMerged;
              window.renderCatalog();
            }
          })
          .catch(() => {})
          .finally(() => {
            window.renderCatalog();
          });
      };

      // Render Table with active filters & pagination
      window.renderCatalog = function() {
        const tbody = document.getElementById('catalogTableBody');
        const infoEl = document.getElementById('catalogPaginationInfo');
        const controlsEl = document.getElementById('paginationControls');
        const totalSkusEl = document.getElementById('kpiTotalSkus');
        const countAllEl = document.getElementById('countAll');

        if (!tbody) return;

        if (totalSkusEl) totalSkusEl.textContent = `${catalogItems.length} SKUs`;
        if (countAllEl) countAllEl.textContent = catalogItems.length;

        // Filter dataset
        const filtered = catalogItems.filter(item => {
          const matchCat = currentFilter === 'all' || (item.category && item.category.toLowerCase() === currentFilter.toLowerCase());
          const q = searchQuery.toLowerCase();
          const matchSearch = !q || 
            (item.name && item.name.toLowerCase().includes(q)) || 
            (item.sku && item.sku.toLowerCase().includes(q)) || 
            (item.description && item.description.toLowerCase().includes(q));
          return matchCat && matchSearch;
        });

        const totalPages = Math.ceil(filtered.length / pageSize) || 1;
        if (currentPage > totalPages) currentPage = totalPages;

        const startIndex = (currentPage - 1) * pageSize;
        const pageItems = filtered.slice(startIndex, startIndex + pageSize);

        if (infoEl) {
          const end = Math.min(startIndex + pageSize, filtered.length);
          infoEl.textContent = `Showing ${filtered.length === 0 ? 0 : startIndex + 1}–${end} of ${filtered.length} products`;
        }

        // Render rows
        tbody.innerHTML = '';
        if (pageItems.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="8" class="text-center py-12 text-slate-500">
                No products found matching your search.
              </td>
            </tr>
          `;
        } else {
          pageItems.forEach(item => {
            const price = Number(item.price) || 0;
            const cost = Number(item.cost) || 0;
            const margin = price > 0 ? Math.round(((price - cost) / price) * 100) : 0;
            const isCustom = Boolean(item.is_custom);
            const tr = document.createElement('tr');
            tr.className = `hover:bg-slate-800/40 transition-colors ${isCustom ? 'bg-emerald-950/20 border-l-4 border-emerald-400' : ''}`;
            tr.innerHTML = `
              <td class="px-4 py-3 font-mono font-bold text-sky-400 text-xs">
                ${item.sku || 'SKU-' + item.id}
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="font-bold text-white text-xs sm:text-sm">${item.name}</span>
                  ${isCustom ? `
                    <span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[9px] font-black uppercase tracking-wider">
                      NEW
                    </span>
                    <button 
                      type="button" 
                      onclick="window.deleteCustomProduct('${item.id}')" 
                      title="Delete this uploaded product" 
                      class="text-rose-400 hover:text-rose-300 text-xs font-mono ml-1 px-1 rounded hover:bg-rose-500/20 cursor-pointer"
                    >
                      ✕ Remove
                    </button>
                  ` : ''}
                </div>
                <div class="text-[11px] text-slate-400 line-clamp-1">${item.description || ''}</div>
              </td>
              <td class="px-3 py-3">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
                  item.category === 'Hardware' 
                    ? 'bg-blue-500/20 text-blue-300 border border-blue-500/40' 
                    : (item.category === 'Software'
                      ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40'
                      : 'bg-purple-500/20 text-purple-300 border border-purple-500/40')
                }">
                  ${item.category || 'General'}
                </span>
              </td>
              <td class="px-3 py-3 text-right font-mono font-bold text-white">
                $${price.toLocaleString()}
              </td>
              <td class="px-3 py-3 text-right font-mono text-slate-400">
                $${cost.toLocaleString()}
              </td>
              <td class="px-3 py-3 text-center">
                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold ${
                  margin >= 35 ? 'bg-emerald-500/20 text-emerald-300' : (margin >= 20 ? 'bg-amber-500/20 text-amber-300' : 'bg-rose-500/20 text-rose-300')
                }">
                  ${margin}%
                </span>
              </td>
              <td class="px-3 py-3 text-center">
                <span class="text-[10px] font-medium ${item.is_subscription ? 'text-amber-300' : 'text-slate-400'}">
                  ${item.is_subscription ? 'Recurring SaaS' : 'One-Time Outlay'}
                </span>
              </td>
              <td class="px-3 py-3 text-center font-mono text-xs">
                <span class="${(item.stock || 0) > 10 ? 'text-emerald-400 font-semibold' : ((item.stock || 0) > 0 ? 'text-amber-400' : 'text-rose-400')}">
                  ${item.stock !== undefined ? item.stock : 45}
                </span>
              </td>
            `;
            tbody.appendChild(tr);
          });
        }

        // Render Pagination Controls
        if (controlsEl) {
          controlsEl.innerHTML = '';
          
          // Prev button
          const prevBtn = document.createElement('button');
          prevBtn.type = 'button';
          prevBtn.className = `px-2.5 py-1 rounded-lg border border-slate-700 font-bold transition-all ${currentPage > 1 ? 'hover:bg-slate-800 text-slate-200 cursor-pointer' : 'text-slate-600 cursor-not-allowed'}`;
          prevBtn.textContent = '← Prev';
          prevBtn.disabled = currentPage === 1;
          prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; window.renderCatalog(); } };
          controlsEl.appendChild(prevBtn);

          // Page pills (up to 5 pages shown)
          let startP = Math.max(1, currentPage - 2);
          let endP = Math.min(totalPages, startP + 4);
          if (endP - startP < 4) startP = Math.max(1, endP - 4);

          for (let p = startP; p <= endP; p++) {
            const pBtn = document.createElement('button');
            pBtn.type = 'button';
            pBtn.className = `w-7 h-7 rounded-lg text-xs font-bold transition-all ${p === currentPage ? 'bg-sky-400 text-slate-950 shadow-md' : 'border border-slate-700 text-slate-300 hover:bg-slate-800 cursor-pointer'}`;
            pBtn.textContent = p;
            pBtn.onclick = () => { currentPage = p; window.renderCatalog(); };
            controlsEl.appendChild(pBtn);
          }

          // Next button
          const nextBtn = document.createElement('button');
          nextBtn.type = 'button';
          nextBtn.className = `px-2.5 py-1 rounded-lg border border-slate-700 font-bold transition-all ${currentPage < totalPages ? 'hover:bg-slate-800 text-slate-200 cursor-pointer' : 'text-slate-600 cursor-not-allowed'}`;
          nextBtn.textContent = 'Next →';
          nextBtn.disabled = currentPage === totalPages;
          nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; window.renderCatalog(); } };
          controlsEl.appendChild(nextBtn);
        }
      };

      // Live Margin Preview
      window.updateMarginPreview = function() {
        const price = parseFloat(document.getElementById('prodPrice')?.value) || 0;
        const cost = parseFloat(document.getElementById('prodCost')?.value) || 0;
        const badge = document.getElementById('marginBadge');

        if (!badge) return;
        if (price <= 0) {
          badge.textContent = 'Enter price and cost';
          badge.className = 'h-[42px] flex items-center px-4 rounded-xl border border-slate-700 bg-slate-800/80 font-mono text-sm font-bold text-slate-400';
          return;
        }

        const margin = Math.round(((price - cost) / price) * 100);
        badge.textContent = `${margin}% Gross Margin ($${Math.round(price - cost).toLocaleString()} spread)`;
        if (margin >= 35) {
          badge.className = 'h-[42px] flex items-center px-4 rounded-xl border border-emerald-500/40 bg-emerald-500/10 font-mono text-sm font-bold text-emerald-300';
        } else if (margin >= 20) {
          badge.className = 'h-[42px] flex items-center px-4 rounded-xl border border-amber-500/40 bg-amber-500/10 font-mono text-sm font-bold text-amber-300';
        } else {
          badge.className = 'h-[42px] flex items-center px-4 rounded-xl border border-rose-500/40 bg-rose-500/10 font-mono text-sm font-bold text-rose-300';
        }
      };

      window.handleCategoryChange = function(val) {
        const billingSelect = document.getElementById('prodBilling');
        if (billingSelect) {
          if (val === 'Services' || val === 'Software' || val === 'Security') {
            billingSelect.value = 'monthly';
          } else {
            billingSelect.value = 'One-Time';
          }
        }
      };

      // Filter by Category Pill
      window.setCategoryFilter = function(cat, btn) {
        currentFilter = cat;
        currentPage = 1;
        document.querySelectorAll('.cat-filter').forEach(b => {
          b.classList.remove('bg-sky-400', 'text-slate-950');
          b.classList.add('text-slate-300', 'bg-slate-800');
        });
        if (btn) {
          btn.classList.add('bg-sky-400', 'text-slate-950');
          btn.classList.remove('text-slate-300', 'bg-slate-800');
        }
        window.renderCatalog();
      };

      // Live search filter
      window.filterCatalog = function() {
        const input = document.getElementById('catalogSearch');
        searchQuery = input ? input.value : '';
        currentPage = 1;
        window.renderCatalog();
      };

      // Pre-fill realistic demo data for 1-click testing
      window.fillDemoProduct = function() {
        const demoList = [
          {
            name: "Nexus Core 100G Leaf Switch",
            sku: "HW-NX-100G-" + Math.floor(100 + Math.random() * 900),
            category: "Hardware",
            price: 8500,
            cost: 4900,
            billing: "One-Time",
            unit: "each",
            tax: 8.0,
            stock: 35,
            desc: "High-density 100GbE data center leaf switch with 32x QSFP28 ports and redundant hot-swappable PSUs."
          },
          {
            name: "Enterprise Managed SIEM & Threat Hunting",
            sku: "SVC-SIEM-" + Math.floor(100 + Math.random() * 900),
            category: "Services",
            price: 2400,
            cost: 950,
            billing: "monthly",
            unit: "monthly",
            tax: 6.5,
            stock: 999,
            desc: "24x7 autonomous security operations center (SOC) monitoring, real-time telemetry correlation, and incident response SLA."
          },
          {
            name: "Cloud Native Zero-Trust Gateway License",
            sku: "SW-ZTNA-" + Math.floor(100 + Math.random() * 900),
            category: "Software",
            price: 360,
            cost: 110,
            billing: "annual",
            unit: "license",
            tax: 7.0,
            stock: 500,
            desc: "Identity-aware secure web gateway and micro-segmentation proxy per seat with automated policy enforcement."
          },
          {
            name: "Titan Storage Array NVMe 120TB Expansion",
            sku: "HW-SAN-120T-" + Math.floor(100 + Math.random() * 900),
            category: "Hardware",
            price: 19500,
            cost: 12200,
            billing: "One-Time",
            unit: "each",
            tax: 8.25,
            stock: 12,
            desc: "Dual-controller enterprise NVMe-oF all-flash array delivering up to 1.8M IOPS and sub-millisecond read latency."
          }
        ];
        const item = demoList[Math.floor(Math.random() * demoList.length)];
        
        const nameEl = document.getElementById('prodName');
        const skuEl = document.getElementById('prodSku');
        const catEl = document.getElementById('prodCategory');
        const priceEl = document.getElementById('prodPrice');
        const costEl = document.getElementById('prodCost');
        const billEl = document.getElementById('prodBilling');
        const unitEl = document.getElementById('prodUnit');
        const taxEl = document.getElementById('prodTax');
        const stockEl = document.getElementById('prodStock');
        const descEl = document.getElementById('prodDesc');

        if (nameEl) nameEl.value = item.name;
        if (skuEl) skuEl.value = item.sku;
        if (catEl) catEl.value = item.category;
        if (priceEl) priceEl.value = item.price;
        if (costEl) costEl.value = item.cost;
        if (billEl) billEl.value = item.billing;
        if (unitEl) unitEl.value = item.unit;
        if (taxEl) taxEl.value = item.tax;
        if (stockEl) stockEl.value = item.stock;
        if (descEl) descEl.value = item.desc;

        window.updateMarginPreview();
        if (window.showToast) {
          window.showToast("Demo product values loaded! Click '+ Add Product to Catalog' to save.", "info");
        }
      };

      // Handle Form Submit: Add Single Product
      window.handleProductSubmit = function(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }

        const nameEl = document.getElementById('prodName');
        const skuEl = document.getElementById('prodSku');
        const catEl = document.getElementById('prodCategory');
        const priceEl = document.getElementById('prodPrice');
        const costEl = document.getElementById('prodCost');
        const billEl = document.getElementById('prodBilling');
        const unitEl = document.getElementById('prodUnit');
        const taxEl = document.getElementById('prodTax');
        const whEl = document.getElementById('prodWarehouse');
        const stockEl = document.getElementById('prodStock');
        const descEl = document.getElementById('prodDesc');

        const name = nameEl ? nameEl.value.trim() : '';
        const rawSku = skuEl ? skuEl.value.trim().toUpperCase() : '';
        const category = catEl ? catEl.value : 'Hardware';
        const price = priceEl ? parseFloat(priceEl.value) || 0 : 0;
        const cost = costEl ? parseFloat(costEl.value) || 0 : 0;
        const billing = billEl ? billEl.value : 'One-Time';
        const unit = unitEl ? unitEl.value : (billing !== 'One-Time' ? 'monthly' : 'each');
        const tax = taxEl ? parseFloat(taxEl.value) || 8.0 : 8.0;
        const warehouse = whEl ? whEl.value : '1';
        const stock = stockEl ? parseInt(stockEl.value) || 0 : 50;
        const desc = descEl ? descEl.value.trim() : '';

        if (!name) {
          if (window.showToast) window.showToast('Please enter a product name', 'error');
          else alert('Please enter a product name');
          if (nameEl) nameEl.focus();
          return false;
        }

        if (price <= 0) {
          if (window.showToast) window.showToast('Please enter a list selling price greater than $0', 'error');
          else alert('Please enter a list selling price greater than $0');
          if (priceEl) priceEl.focus();
          return false;
        }

        const sku = rawSku || ('SKU-' + Date.now().toString().slice(-6));
        const isSub = billing !== 'One-Time';

        const newProduct = {
          id: Date.now(),
          sku: sku,
          name: name,
          category: category,
          price: price,
          cost: cost,
          unit: unit,
          tax: tax,
          warehouse_id: parseInt(warehouse) || 1,
          is_subscription: isSub,
          stock: stock,
          description: desc,
          is_custom: true,
          created_at: new Date().toISOString()
        };

        // 1. Save to LocalStorage custom products
        let customProducts = [];
        try {
          const raw = localStorage.getItem('dealflow360_custom_products');
          if (raw) customProducts = JSON.parse(raw);
        } catch (err) {}

        customProducts.unshift(newProduct);
        localStorage.setItem('dealflow360_custom_products', JSON.stringify(customProducts));

        // 2. Prepend to catalogItems
        catalogItems.unshift(newProduct);

        // 3. Dispatch global events so QuotationBuilder and other components immediately pick up the new SKU
        try {
          window.dispatchEvent(new CustomEvent('dealflow360_product_added', { detail: newProduct }));
          window.dispatchEvent(new Event('storage'));
        } catch (err) {}

        // 4. Try POST to backend FastAPI server if active
        try {
          fetch('http://localhost:8000/api/products', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: name,
              category: category,
              price: price,
              unit: unit,
              tax: tax,
              is_subscription: isSub,
              description: desc
            })
          }).catch(() => {});
        } catch (err) {}

        // 5. User feedback
        if (window.showToast) {
          window.showToast(`Product "${name}" (${sku}) uploaded successfully! Added to catalog & quotation builder.`, 'success');
        } else {
          alert(`Product "${name}" (${sku}) uploaded successfully!`);
        }

        // 6. Reset form & margin badge
        const form = document.getElementById('productForm');
        if (form) form.reset();
        const badge = document.getElementById('marginBadge');
        if (badge) {
          badge.textContent = 'Enter price and cost';
          badge.className = 'h-[42px] flex items-center px-4 rounded-xl border border-slate-700 bg-slate-800/80 font-mono text-sm font-bold text-slate-400';
        }

        // 7. Reset filters & jump to top of catalog table to view new product
        currentFilter = 'all';
        searchQuery = '';
        const searchInput = document.getElementById('catalogSearch');
        if (searchInput) searchInput.value = '';
        currentPage = 1;

        window.switchTab('catalog');
        window.renderCatalog();
        return false;
      };

      // Remove custom product
      window.deleteCustomProduct = function(id) {
        if (!confirm('Are you sure you want to remove this uploaded product from catalog?')) return;
        try {
          let custom = JSON.parse(localStorage.getItem('dealflow360_custom_products') || '[]');
          custom = custom.filter(p => String(p.id) !== String(id));
          localStorage.setItem('dealflow360_custom_products', JSON.stringify(custom));
        } catch (e) {}

        catalogItems = catalogItems.filter(p => String(p.id) !== String(id));
        try {
          window.dispatchEvent(new Event('storage'));
        } catch (e) {}

        window.renderCatalog();
        if (window.showToast) window.showToast('Product removed from catalog', 'info');
      };

      // Bulk CSV Processing
      window.processBulkCsv = function() {
        const text = document.getElementById('bulkCsvText')?.value.trim();
        const statusEl = document.getElementById('bulkStatusText');
        if (!text) {
          if (window.showToast) window.showToast('Please paste CSV rows first', 'error');
          return;
        }

        const lines = text.split('\n');
        let count = 0;
        let newCustom = [];

        try {
          const raw = localStorage.getItem('dealflow360_custom_products');
          if (raw) newCustom = JSON.parse(raw);
        } catch (e) {}

        lines.forEach((line, idx) => {
          const parts = line.split(',').map(s => s.trim());
          if (parts.length >= 4) {
            const sku = parts[0] || `SKU-${Date.now()}-${idx}`;
            const name = parts[1] || `Catalog Item ${idx + 1}`;
            const cat = parts[2] || 'Hardware';
            const price = parseFloat(parts[3]) || 1000;
            const cost = parseFloat(parts[4]) || Math.round(price * 0.6);
            const billing = parts[5] || 'One-Time';
            const stock = parseInt(parts[6]) || 30;

            const isSub = billing.toLowerCase().includes('month') || billing.toLowerCase().includes('sub');

            const prod = {
              id: Date.now() + idx,
              sku: sku,
              name: name,
              category: cat,
              price: price,
              cost: cost,
              unit: isSub ? 'monthly' : 'each',
              tax: 8.0,
              is_subscription: isSub,
              stock: stock,
              is_custom: true,
              description: `Imported via bulk CSV on ${new Date().toLocaleDateString()}`
            };

            newCustom.unshift(prod);
            catalogItems.unshift(prod);
            count++;
          }
        });

        localStorage.setItem('dealflow360_custom_products', JSON.stringify(newCustom));
        try {
          window.dispatchEvent(new Event('storage'));
        } catch (e) {}

        if (statusEl) statusEl.textContent = `✓ Successfully imported ${count} products into catalog!`;
        if (window.showToast) window.showToast(`Batch Ingestion Complete: ${count} products imported!`, 'success');

        setTimeout(() => {
          window.switchTab('catalog');
          window.renderCatalog();
        }, 600);
      };

      window.downloadSampleCsv = function() {
        const csv = `SKU,Name,Category,Price,Cost,Billing,Stock\nHW-EDG-4000,Edge Gateway Server 4000,Hardware,7800,4800,One-Time,25\nSVC-SOC-247,24/7 Autonomous SOC Defense,Services,1800,720,monthly,999\nHW-SAN-60TB,All-Flash SAN Storage 60TB,Hardware,14200,8900,One-Time,15\nSVC-SLA-PLAT,Platinum 15-Min Response SLA,Services,2200,880,monthly,999`;

        const blob = new Blob([csv], { type: 'text/csv' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.setAttribute('href', url);
        a.setAttribute('download', 'dealflow360_catalog_sample.csv');
        a.click();
      };

      // Initialization routine
      function initApp() {
        window.loadCatalogData();

        const form = document.getElementById('productForm');
        if (form) {
          form.removeEventListener('submit', window.handleProductSubmit);
          form.addEventListener('submit', window.handleProductSubmit);
        }

        const btnFillDemo = document.getElementById('btnFillDemo');
        if (btnFillDemo) {
          btnFillDemo.onclick = window.fillDemoProduct;
        }

        const priceInput = document.getElementById('prodPrice');
        const costInput = document.getElementById('prodCost');
        if (priceInput) priceInput.oninput = window.updateMarginPreview;
        if (costInput) costInput.oninput = window.updateMarginPreview;

        const searchInput = document.getElementById('catalogSearch');
        if (searchInput) searchInput.oninput = window.filterCatalog;
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp);
      } else {
        initApp();
      }
    })();
  </script>
</Layout>
