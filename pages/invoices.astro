    window.printInvoicePDF = function(invId) {
      const inv = allInvoices.find(i => i.id === invId);
      if (!inv) return;

      activePdfInvoice = inv;
      const sheet = document.getElementById('invoicePrintSheet');
      const titleEl = document.getElementById('pdfModalTitle');
      const subTitleEl = document.getElementById('pdfModalSubtitle');

      if (titleEl) titleEl.textContent = `Invoice Document • ${inv.invoice_number}`;
      if (subTitleEl) subTitleEl.textContent = `Client: ${inv.customer} • Amount: $${inv.amount.toLocaleString()} (${inv.status})`;

      if (sheet) {
        sheet.innerHTML = generateInvoiceHTML(inv);
      }

      const modal = document.getElementById('invoicePdfModal');
      if (modal) {
        modal.classList.remove('hidden');
      }
    };

    window.closeInvoicePdfModal = function() {
      const modal = document.getElementById('invoicePdfModal');
      if (modal) {
        modal.classList.add('hidden');
      }
    };

    window.triggerDirectPrint = function() {
      const sheet = document.getElementById('invoicePrintSheet');
      if (!sheet) return;

      const printWindow = window.open('', '_blank', 'width=840,height=920');
      if (!printWindow) {
        window.print();
        return;
      }

      printWindow.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
          <title>${activePdfInvoice ? activePdfInvoice.invoice_number : 'Invoice'} - DealFlow360</title>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <style>
            * { box-sizing: border-box; }
            body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 24px; color: #0f172a; background: #fff; }
            @page { size: A4 portrait; margin: 10mm; }
          </style>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
          <script src="https://cdn.tailwindcss.com"><\/script>
        </head>
        <body onload="window.focus(); setTimeout(() => { window.print(); }, 450);">
          <div style="max-width: 800px; margin: 0 auto;">
            ${sheet.innerHTML}
          </div>
        </body>
        </html>
      `);
      printWindow.document.close();
    };

    window.downloadInvoicePDFFile = function() {
      const sheet = document.getElementById('invoicePrintSheet');
      if (!sheet) return;

      const filename = activePdfInvoice ? `Invoice_${activePdfInvoice.invoice_number}.pdf` : 'Invoice.pdf';
      const btn = document.getElementById('downloadPdfBtn');
      const origText = btn ? btn.innerHTML : '';
      if (btn) btn.innerHTML = '<span>Generating PDF...</span>';

      if (window.html2pdf) {
        const opt = {
          margin: 8,
          filename: filename,
          image: { type: 'jpeg', quality: 0.98 },
          html2canvas: { scale: 2, useCORS: true, letterRendering: true },
          jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        window.html2pdf().set(opt).from(sheet).save().then(() => {
          if (btn) btn.innerHTML = origText;
          if (window.showToast) window.showToast(`Downloaded ${filename} in PDF format!`, 'success');
        }).catch(err => {
          console.error(err);
          if (btn) btn.innerHTML = origText;
          window.triggerDirectPrint();
        });
      } else {
        if (btn) btn.innerHTML = origText;
        window.triggerDirectPrint();
      }
    };

    document.addEventListener('DOMContentLoaded', () => {
      loadMergedInvoices();
      renderInvoices();
    });

    window.addEventListener('storage', () => {
      loadMergedInvoices();
      renderInvoices();
    });

    window.addEventListener('dealflow360_billing_updated', () => {
